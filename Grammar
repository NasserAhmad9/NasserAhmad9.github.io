<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="light" data-color="brown">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>مكتبة الآجرومية الشاملة | متن + نظم + شواهد + اختبارات</title>
<link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Cairo:wght@300;400;600;700&family=Scheherazade+New:wght@400;700&family=Lateef&family=Noto+Naskh+Arabic:wght@400;700&family=Reem+Kufi:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{
  --base-size:17px;--font-body:'Amiri','Scheherazade New',serif;--font-ui:'Cairo',sans-serif;
  --bg:#f7f3ea;--surface:#fff;--surface-2:#f3ecdd;--text:#2a2016;--text-soft:#5c4b36;
  --muted:#8a7a63;--border:#e5d9c3;--accent:#8b4513;--accent-2:#b8860b;--accent-soft:#f0e0c0;
  --q-bg:linear-gradient(135deg,#fff8e7,#fdf0d5);--a-bg:#fbfbf7;--poem-bg:linear-gradient(135deg,#f5f0e0,#ede2c8);
  --matn-bg:linear-gradient(135deg,#eef5e8,#e2ebd9);--alfia-bg:linear-gradient(135deg,#f3ecf9,#e8d8f5);
  --shadow:0 4px 20px rgba(139,69,19,.08);--shadow-lg:0 12px 40px rgba(139,69,19,.14);
  --radius:14px;--header-h:112px;--sidebar-w:290px;--transition:.28s cubic-bezier(.4,0,.2,1);
}
[data-color="green"]{--accent:#2d6a4f;--accent-2:#52b788;--accent-soft:#d8f3dc;--q-bg:linear-gradient(135deg,#edf7f0,#d8f3dc);--matn-bg:linear-gradient(135deg,#e8f4ed,#d8ebde);--poem-bg:linear-gradient(135deg,#eef7f1,#e2ede6);--alfia-bg:linear-gradient(135deg,#e8f0ec,#dce8e2)}
[data-color="blue"]{--accent:#1d4e89;--accent-2:#4895ef;--accent-soft:#d6e8fa;--q-bg:linear-gradient(135deg,#ecf3fc,#d6e8fa);--matn-bg:linear-gradient(135deg,#e6f0f9,#d8e5f3);--poem-bg:linear-gradient(135deg,#ecf3fa,#e2ecf7);--alfia-bg:linear-gradient(135deg,#e6edf5,#dae3ee)}
[data-color="purple"]{--accent:#5a189a;--accent-2:#9d4edd;--accent-soft:#e8d8f5;--q-bg:linear-gradient(135deg,#f3ecf9,#e8d8f5);--matn-bg:linear-gradient(135deg,#f0e9f5,#e6dff0);--poem-bg:linear-gradient(135deg,#f3ecf7,#eae2f2);--alfia-bg:linear-gradient(135deg,#eee6f5,#e4daee)}
[data-color="teal"]{--accent:#006d77;--accent-2:#2a9d8f;--accent-soft:#d1e8ea;--q-bg:linear-gradient(135deg,#ebf5f6,#d1e8ea);--matn-bg:linear-gradient(135deg,#e6f0f1,#d8e8e9);--poem-bg:linear-gradient(135deg,#edf4f5,#e2eaeb);--alfia-bg:linear-gradient(135deg,#e4eded,#dae5e5)}
[data-color="rose"]{--accent:#a4133c;--accent-2:#ff4d6d;--accent-soft:#ffd6de;--q-bg:linear-gradient(135deg,#fdf0f3,#ffd6de);--matn-bg:linear-gradient(135deg,#faebef,#f2dde2);--poem-bg:linear-gradient(135deg,#fdf0f2,#f2e2e5);--alfia-bg:linear-gradient(135deg,#f5e8ec,#eedde3)}
[data-theme="dark"]{--bg:#14100c;--surface:#211a13;--surface-2:#2b2218;--text:#f0e6d6;--text-soft:#d4c5ad;--muted:#9c8b74;--border:#3a2f22;--accent:#e0a86a;--accent-2:#f0c674;--accent-soft:#3a2b1a;--q-bg:linear-gradient(135deg,#2b2218,#241c13);--a-bg:#1c1610;--poem-bg:linear-gradient(135deg,#2b2418,#241c13);--matn-bg:linear-gradient(135deg,#1d2617,#182012);--alfia-bg:linear-gradient(135deg,#261e2e,#1e1828);--shadow:0 4px 20px rgba(0,0,0,.4);--shadow-lg:0 12px 40px rgba(0,0,0,.6)}
[data-theme="dark"][data-color="green"]{--accent:#95d5b2;--accent-2:#b7e4c7;--accent-soft:#1b3a28;--q-bg:linear-gradient(135deg,#1a2e21,#152619);--matn-bg:linear-gradient(135deg,#172418,#12201a);--poem-bg:linear-gradient(135deg,#1c2c1f,#182420);--alfia-bg:linear-gradient(135deg,#1a2620,#15201a)}
[data-theme="dark"][data-color="blue"]{--accent:#90caf9;--accent-2:#bbdefb;--accent-soft:#1a2a3d;--q-bg:linear-gradient(135deg,#1a2432,#15202c);--matn-bg:linear-gradient(135deg,#16212d,#12202d);--poem-bg:linear-gradient(135deg,#1c2634,#18232f);--alfia-bg:linear-gradient(135deg,#18202d,#121a28)}
[data-theme="dark"][data-color="purple"]{--accent:#d0a3e8;--accent-2:#e0b8f0;--accent-soft:#2d1a3d;--q-bg:linear-gradient(135deg,#251c2e,#1e1628);--matn-bg:linear-gradient(135deg,#1e1825,#1a1520);--poem-bg:linear-gradient(135deg,#281e32,#21182b);--alfia-bg:linear-gradient(135deg,#22192e,#1a1328)}
[data-theme="dark"][data-color="teal"]{--accent:#80cbc4;--accent-2:#a7dad3;--accent-soft:#0f2a2d;--q-bg:linear-gradient(135deg,#15282a,#122123);--matn-bg:linear-gradient(135deg,#132222,#101e1e);--poem-bg:linear-gradient(135deg,#1c2c2e,#182527);--alfia-bg:linear-gradient(135deg,#162425,#122022)}
[data-theme="dark"][data-color="rose"]{--accent:#f4a5b2;--accent-2:#f8c4ce;--accent-soft:#3d1520;--q-bg:linear-gradient(135deg,#2d1a20,#25151a);--matn-bg:linear-gradient(135deg,#221820,#1e141a);--poem-bg:linear-gradient(135deg,#2b1c22,#241620);--alfia-bg:linear-gradient(135deg,#281a22,#20141c)}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:calc(var(--header-h) + 20px)}
body{font-family:var(--font-ui);font-size:var(--base-size);background:var(--bg);color:var(--text);line-height:1.8;transition:background .28s,color .28s;overflow-x:hidden}
::selection{background:var(--accent);color:#fff}
a{color:var(--accent);text-decoration:none}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
#loader{position:fixed;inset:0;background:var(--bg);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:24px;z-index:2000;transition:opacity .5s,visibility .5s}
#loader.hidden{opacity:0;visibility:hidden;pointer-events:none}
#loader .basmala{font-family:var(--font-body);font-size:1.6rem;color:var(--accent);font-weight:700}
#loader .ring{width:52px;height:52px;border:3px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin 1s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
#loader .msg{font-size:.88rem;color:var(--muted)}
#progress-bar{position:fixed;top:0;right:0;height:3px;width:0;background:linear-gradient(90deg,var(--accent),var(--accent-2));z-index:1000;transition:width .1s linear}
header#top-bar{position:fixed;top:0;right:0;left:0;min-height:var(--header-h);background:color-mix(in srgb,var(--surface) 94%,transparent);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--border);display:flex;flex-direction:column;z-index:900;box-shadow:0 2px 12px rgba(0,0,0,.04)}
.top-row{display:flex;align-items:center;gap:8px;padding:8px 12px;height:54px}
.brand{display:flex;flex-direction:column;line-height:1.15;margin-left:auto;flex:1;min-width:0}
.brand h1{font-family:var(--font-body);font-size:1rem;font-weight:700;color:var(--accent);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.brand small{font-size:.68rem;color:var(--muted);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.hdr-btn{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--text-soft);transition:all .2s;flex-shrink:0}
.hdr-btn:hover{background:var(--surface-2);color:var(--accent)}
.hdr-btn svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.main-nav{display:flex;gap:2px;padding:0 8px 6px;border-top:1px solid var(--border);overflow-x:auto;scrollbar-width:none;height:48px;align-items:center}
.main-nav::-webkit-scrollbar{display:none}
.nav-btn{padding:6px 12px;border-radius:10px;font-size:.76rem;font-weight:600;color:var(--text-soft);white-space:nowrap;transition:all .2s;display:flex;align-items:center;gap:5px;border:1px solid transparent}
.nav-btn:hover{background:var(--surface-2);color:var(--accent)}
.nav-btn.active{background:var(--accent);color:#fff}
.nav-btn .ico{font-size:.9rem}
.search-wrap{position:relative;display:flex;align-items:center;background:var(--surface-2);border:1px solid var(--border);border-radius:10px;padding:4px 10px;gap:6px;width:min(220px,24vw)}
.search-wrap:focus-within{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
.search-wrap svg{width:14px;height:14px;stroke:var(--muted);fill:none;stroke-width:2;flex-shrink:0}
.search-wrap input{border:none;background:transparent;outline:none;font-family:var(--font-ui);font-size:.8rem;color:var(--text);width:100%}
.search-count{font-size:.66rem;color:var(--accent);font-weight:700;white-space:nowrap}
#sidebar{position:fixed;top:var(--header-h);right:0;bottom:0;width:var(--sidebar-w);background:var(--surface);border-left:1px solid var(--border);display:flex;flex-direction:column;z-index:800;transition:transform .28s;box-shadow:-4px 0 20px rgba(0,0,0,.03)}
#sidebar .side-head{padding:12px 14px 8px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
#sidebar .side-head h2{font-family:var(--font-body);font-size:.92rem;color:var(--accent);font-weight:700}
#sidebar .side-head span{font-size:.64rem;color:var(--muted);font-weight:600}
#toc-list{overflow-y:auto;flex:1;padding:6px 4px 16px;scrollbar-width:thin}
#toc-list::-webkit-scrollbar{width:6px}
#toc-list::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}
.toc-item{display:flex;align-items:center;gap:8px;padding:6px 10px;margin:1px 0;border-radius:8px;font-size:.76rem;color:var(--text-soft);border-right:3px solid transparent;transition:all .28s;cursor:pointer;line-height:1.4}
.toc-item:hover{background:var(--surface-2);color:var(--accent)}
.toc-item.active{background:var(--accent-soft);color:var(--accent);border-right-color:var(--accent);font-weight:700}
.toc-item .num{font-size:.6rem;font-weight:700;color:var(--accent-2);background:var(--accent-soft);width:20px;height:20px;border-radius:5px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.toc-item.active .num{background:var(--accent);color:#fff}
#sidebar-toggle{display:none}
main{margin-right:var(--sidebar-w);padding-top:calc(var(--header-h) + 20px);padding-bottom:60px;min-height:100vh;transition:margin .28s}
.content-wrap{max-width:900px;margin:0 auto;padding:0 20px}
.view{display:none}
.view.active{display:block}
/* Chapter page */
.chapter-page{animation:fadeIn .35s ease}
@keyframes fadeIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.chapter-header{background:var(--q-bg);border:1px solid var(--border);border-radius:var(--radius);padding:16px 20px;margin-bottom:18px;box-shadow:var(--shadow);display:flex;align-items:center;gap:12px;flex-wrap:wrap;position:sticky;top:calc(var(--header-h) + 6px);z-index:50;backdrop-filter:blur(8px)}
.chapter-header .ch-num{font-family:var(--font-ui);font-size:.7rem;font-weight:700;background:var(--accent);color:#fff;padding:3px 10px;border-radius:6px}
.chapter-header h2{font-family:var(--font-body);font-size:clamp(1.1rem,2.4vw,1.4rem);color:var(--accent);font-weight:700;flex:1;margin:0}
.chapter-header .ch-actions{display:flex;gap:4px;margin-right:auto}
.section-block{margin-bottom:16px}
.section-label{font-family:var(--font-ui);font-size:.7rem;font-weight:700;color:var(--accent);display:inline-flex;align-items:center;gap:5px;margin-bottom:6px;padding:3px 10px;background:var(--surface-2);border-radius:20px}
.matn-card{background:var(--matn-bg);border:1px solid var(--border);border-right:4px solid #5a8f4e;border-radius:var(--radius);padding:14px 18px;margin-bottom:12px;box-shadow:var(--shadow);font-family:var(--font-body);font-size:1rem;line-height:2;color:var(--text);text-align:justify;position:relative}
[data-theme="dark"] .matn-card{border-right-color:#95d5b2}
.matn-card p{margin-bottom:10px;text-indent:1.5em}
.matn-card p:last-child{margin-bottom:0}
.nazm-card{background:var(--poem-bg);border:1px solid var(--border);border-right:4px solid var(--accent-2);border-radius:var(--radius);padding:10px 16px;margin-bottom:12px;box-shadow:var(--shadow);text-align:center}
.nazm-card .bayt{font-family:var(--font-body);font-size:.98rem;line-height:1.95;color:var(--text);font-weight:600;padding:5px 4px;border-bottom:1px dashed var(--border);position:relative;display:flex;flex-direction:column;align-items:center;gap:2px;transition:background .2s}
.nazm-card .bayt:last-child{border-bottom:none}
.nazm-card .bayt:hover{background:var(--accent-soft);border-radius:6px}
.nazm-card .bayt .sadr{display:block}
.nazm-card .bayt .ajz{display:block;color:var(--accent)}
.nazm-card .bayt-actions{position:absolute;top:2px;left:4px;display:flex;gap:2px;opacity:0;transition:opacity .2s}
.nazm-card .bayt:hover .bayt-actions{opacity:1}
.alfia-card{background:var(--alfia-bg);border:1px solid var(--border);border-right:4px solid #7c3aed;border-radius:var(--radius);padding:10px 16px;margin-bottom:12px;box-shadow:var(--shadow);text-align:center}
[data-theme="dark"] .alfia-card{border-right-color:#c084fc}
.alfia-card .bayt{font-family:var(--font-body);font-size:.96rem;line-height:1.9;color:var(--text);font-weight:600;padding:4px 4px;border-bottom:1px dashed var(--border);position:relative;display:flex;flex-direction:column;align-items:center;gap:1px}
.alfia-card .bayt:last-child{border-bottom:none}
.alfia-card .bayt:hover{background:var(--accent-soft);border-radius:6px}
.alfia-card .bayt .sadr{display:block}
.alfia-card .bayt .ajz{display:block;color:#7c3aed}
[data-theme="dark"] .alfia-card .bayt .ajz{color:#c084fc}
.qa-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);margin-bottom:12px;overflow:hidden;box-shadow:var(--shadow);position:relative}
.qa-card .q{display:flex;gap:8px;padding:10px 14px;background:var(--q-bg);border-bottom:1px solid var(--border);align-items:flex-start}
.qa-card .q .lbl{font-family:var(--font-ui);font-weight:700;font-size:.66rem;background:var(--accent);color:#fff;padding:2px 8px;border-radius:6px;flex-shrink:0;margin-top:3px}
.qa-card .q p{font-family:var(--font-body);font-size:.98rem;color:var(--text);font-weight:700;line-height:1.55;flex:1}
.qa-card .a{display:flex;gap:8px;padding:10px 14px;background:var(--a-bg);align-items:flex-start}
.qa-card .a .lbl{font-family:var(--font-ui);font-weight:700;font-size:.66rem;background:var(--accent-2);color:#fff;padding:2px 9px;border-radius:6px;flex-shrink:0;margin-top:3px}
.qa-card .a .a-body{font-family:var(--font-body);font-size:.94rem;color:var(--text-soft);line-height:1.8;flex:1}
.qa-card .a .a-body p{margin-bottom:6px}
.qa-card .a .a-body p:last-child{margin-bottom:0}
.qa-card .a .a-body strong{color:var(--accent);font-weight:700}
.copy-share{display:inline-flex;gap:3px;margin-right:auto}
.icon-btn{width:26px;height:26px;border-radius:6px;display:flex;align-items:center;justify-content:center;color:var(--muted);transition:all .2s;background:transparent}
.icon-btn:hover{background:var(--surface-2);color:var(--accent)}
.icon-btn.fav{color:var(--accent-2)}
.icon-btn.fav.saved{color:#e63946;background:#ffe4e8}
.icon-btn svg{width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.icon-btn.fav.saved svg{fill:currentColor}
.toast{position:fixed;bottom:80px;left:50%;transform:translateX(-50%) translateY(20px);background:var(--accent);color:#fff;padding:10px 20px;border-radius:10px;font-family:var(--font-ui);font-size:.82rem;font-weight:600;box-shadow:var(--shadow-lg);opacity:0;pointer-events:none;transition:opacity .3s,transform .3s;z-index:3000}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
.empty-state{text-align:center;padding:50px 20px;color:var(--muted);font-family:var(--font-body);font-size:1.05rem}
.empty-state .ico{font-size:3rem;margin-bottom:12px;display:block;opacity:.5}
/* Favorites */
.fav-item{background:var(--poem-bg);border:1px solid var(--border);border-right:4px solid #e63946;border-radius:var(--radius);padding:14px 18px;position:relative;font-family:var(--font-body);margin-bottom:10px}
.fav-item .fav-chapter{font-family:var(--font-ui);font-size:.68rem;color:var(--accent);font-weight:700;margin-bottom:6px;display:flex;align-items:center;gap:6px}
.fav-item .fav-verse{text-align:center;font-size:1rem;line-height:1.9;color:var(--text);font-weight:600}
.fav-item .fav-verse .sadr{display:block}
.fav-item .fav-verse .ajz{display:block;color:var(--accent)}
.fav-item .fav-actions{position:absolute;top:8px;left:8px;display:flex;gap:3px}
/* Quiz */
.quiz-setup{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:20px;margin-bottom:18px;box-shadow:var(--shadow)}
.quiz-setup h3{font-family:var(--font-body);color:var(--accent);font-size:1.15rem;margin-bottom:14px;display:flex;align-items:center;gap:8px}
.form-group{margin-bottom:16px}
.form-label{display:block;font-family:var(--font-ui);font-size:.8rem;font-weight:700;color:var(--text-soft);margin-bottom:6px}
.form-label small{color:var(--muted);font-weight:600}
.chapter-select{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:5px;max-height:240px;overflow-y:auto;padding:8px;background:var(--surface-2);border-radius:10px;border:1px solid var(--border)}
.chapter-check{display:flex;align-items:center;gap:6px;padding:5px 8px;border-radius:6px;font-size:.76rem;color:var(--text-soft);cursor:pointer}
.chapter-check:hover{background:var(--accent-soft)}
.chapter-check input{accent-color:var(--accent)}
.chapter-check.checked{background:var(--accent-soft);color:var(--accent);font-weight:700}
.chapter-controls{display:flex;gap:6px;margin-bottom:8px;flex-wrap:wrap}
.mini-btn{font-family:var(--font-ui);font-size:.7rem;font-weight:700;padding:4px 10px;border-radius:6px;background:var(--surface-2);color:var(--text-soft);border:1px solid var(--border);transition:all .2s}
.mini-btn:hover{background:var(--accent-soft);color:var(--accent);border-color:var(--accent)}
.range-wrap{display:flex;align-items:center;gap:10px}
.range-wrap input[type="range"]{flex:1;accent-color:var(--accent)}
.range-value{font-family:var(--font-ui);font-weight:700;color:var(--accent);min-width:50px;text-align:center;background:var(--surface-2);padding:3px 10px;border-radius:6px;font-size:.82rem}
.btn-primary{background:var(--accent);color:#fff;padding:10px 24px;border-radius:10px;font-weight:700;font-size:.88rem;transition:all .2s;display:inline-flex;align-items:center;gap:8px}
.btn-primary:hover{background:var(--accent-2)}
.btn-secondary{background:var(--surface-2);color:var(--text-soft);padding:8px 18px;border-radius:8px;font-weight:700;font-size:.82rem;border:1px solid var(--border);transition:all .2s}
.btn-secondary:hover{background:var(--accent-soft);color:var(--accent)}
.quiz-progress{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:10px 14px;margin-bottom:14px;display:flex;align-items:center;gap:10px;font-family:var(--font-ui);font-size:.82rem;position:sticky;top:calc(var(--header-h) + 10px);z-index:100;box-shadow:var(--shadow)}
.quiz-progress .bar{flex:1;height:6px;background:var(--surface-2);border-radius:3px;overflow:hidden}
.quiz-progress .bar div{height:100%;background:var(--accent);transition:width .3s}
.quiz-progress .count{color:var(--accent);font-weight:700}
.qz-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px 18px;margin-bottom:14px;box-shadow:var(--shadow)}
.qz-card .qz-header{display:flex;align-items:center;gap:8px;margin-bottom:12px}
.qz-card .qz-num{font-family:var(--font-ui);font-size:.7rem;font-weight:700;background:var(--accent);color:#fff;padding:2px 10px;border-radius:6px}
.qz-card .qz-type{font-family:var(--font-ui);font-size:.66rem;font-weight:700;padding:2px 8px;border-radius:6px;background:var(--accent-soft);color:var(--accent)}
.qz-card .qz-text{font-family:var(--font-body);font-size:1.02rem;font-weight:700;color:var(--text);line-height:1.7;margin-bottom:12px;padding:10px 12px;background:var(--q-bg);border-radius:8px;border-right:3px solid var(--accent);white-space:pre-line}
.qz-options{display:flex;flex-direction:column;gap:8px}
.qz-option{padding:10px 14px;background:var(--surface-2);border:2px solid var(--border);border-radius:8px;font-family:var(--font-body);font-size:.94rem;cursor:pointer;transition:all .2s;text-align:right;line-height:1.6}
.qz-option:hover{border-color:var(--accent);background:var(--accent-soft)}
.qz-option.selected{border-color:var(--accent);background:var(--accent-soft);color:var(--accent);font-weight:700}
.qz-option.correct{border-color:#28a745;background:#d4edda;color:#155724;font-weight:700}
.qz-option.wrong{border-color:#dc3545;background:#f8d7da;color:#721c24;font-weight:700}
[data-theme="dark"] .qz-option.correct{background:#1e3a1e;color:#b7e4c7;border-color:#28a745}
[data-theme="dark"] .qz-option.wrong{background:#3d1a1a;color:#f8c4ce;border-color:#dc3545}
.qz-feedback{margin-top:10px;padding:8px 12px;border-radius:8px;font-family:var(--font-ui);font-size:.8rem;font-weight:700;display:none}
.qz-feedback.show{display:block}
.qz-feedback.ok{background:#d4edda;color:#155724}
.qz-feedback.no{background:#f8d7da;color:#721c24}
[data-theme="dark"] .qz-feedback.ok{background:#1e3a1e;color:#b7e4c7}
[data-theme="dark"] .qz-feedback.no{background:#3d1a1a;color:#f8c4ce}
.quiz-result{background:var(--surface);border:2px solid var(--accent);border-radius:var(--radius);padding:26px;text-align:center;box-shadow:var(--shadow-lg)}
.quiz-result .score-num{font-family:var(--font-body);font-size:3rem;font-weight:700;color:var(--accent);margin:10px 0}
.quiz-result .score-text{font-family:var(--font-body);font-size:1.1rem;color:var(--text-soft);margin-bottom:16px}
.quiz-result .score-pct{font-family:var(--font-ui);font-size:.9rem;color:var(--muted);margin-bottom:20px}
/* Games */
.game-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:18px;margin-bottom:16px;box-shadow:var(--shadow)}
.game-card h3{font-family:var(--font-body);color:var(--accent);font-size:1.1rem;margin-bottom:12px;display:flex;align-items:center;gap:8px}
.match-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.match-item{padding:10px 12px;background:var(--surface-2);border:2px solid var(--border);border-radius:8px;font-family:var(--font-body);font-size:.9rem;cursor:pointer;transition:all .2s;text-align:center;line-height:1.5}
.match-item:hover{border-color:var(--accent)}
.match-item.selected{border-color:var(--accent);background:var(--accent-soft);font-weight:700}
.match-item.matched{background:#d4edda;border-color:#28a745;color:#155724;opacity:.6;pointer-events:none}
[data-theme="dark"] .match-item.matched{background:#1e3a1e;color:#b7e4c7}
.arrange-container{display:flex;flex-direction:column;gap:12px}
.arrange-target{min-height:80px;background:var(--surface-2);border:2px dashed var(--border);border-radius:10px;padding:10px;display:flex;flex-wrap:wrap;gap:6px;align-content:flex-start}
.arrange-source{display:flex;flex-wrap:wrap;gap:6px}
.arrange-word{padding:6px 12px;background:var(--accent-soft);color:var(--accent);border:1px solid var(--accent-2);border-radius:8px;font-family:var(--font-body);font-size:.92rem;font-weight:600;cursor:pointer;transition:all .2s;user-select:none}
.arrange-word:hover{background:var(--accent);color:#fff}
.arrange-word.used{opacity:.3;pointer-events:none}
/* Settings */
.settings-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:18px 20px;margin-bottom:16px;box-shadow:var(--shadow)}
.settings-card h3{font-family:var(--font-body);color:var(--accent);font-size:1.05rem;margin-bottom:12px;display:flex;align-items:center;gap:8px;padding-bottom:8px;border-bottom:1px solid var(--border)}
.setting-row{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px dashed var(--border);flex-wrap:wrap}
.setting-row:last-child{border-bottom:none}
.setting-label{font-family:var(--font-ui);font-size:.85rem;font-weight:700;color:var(--text-soft);min-width:110px}
.setting-control{flex:1;display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.font-btn{width:32px;height:32px;border-radius:8px;background:var(--surface-2);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--text-soft);transition:all .2s}
.font-btn:hover{background:var(--accent-soft);color:var(--accent)}
.font-btn.active{background:var(--accent);color:#fff;border-color:var(--accent)}
.select-input{padding:8px 12px;background:var(--surface-2);border:1px solid var(--border);border-radius:8px;font-family:var(--font-ui);font-size:.85rem;color:var(--text);min-width:180px}
.select-input:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
.color-swatches{display:flex;gap:8px;flex-wrap:wrap}
.color-swatch{width:40px;height:40px;border-radius:50%;border:3px solid transparent;cursor:pointer;transition:all .2s;position:relative}
.color-swatch.active{border-color:var(--text);transform:scale(1.1)}
.color-swatch.active::after{content:"✓";position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:1.2rem;text-shadow:0 0 3px rgba(0,0,0,.5)}
.preview-box{background:var(--surface-2);border:1px solid var(--border);border-radius:10px;padding:16px;margin-top:12px;font-family:var(--font-body);color:var(--text);line-height:1.9;text-align:center}
.preview-box .pv-title{font-weight:700;color:var(--accent);margin-bottom:6px}
#to-top{position:fixed;bottom:18px;left:18px;width:40px;height:40px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;box-shadow:var(--shadow-lg);z-index:700;opacity:0;pointer-events:none;transform:translateY(16px);transition:opacity .3s,transform .3s}
#to-top.show{opacity:1;pointer-events:auto;transform:translateY(0)}
#to-top:hover{background:var(--accent-2)}
#to-top svg{width:18px;height:18px;stroke:#fff;fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}
/* Timer */
.timer-box{display:flex;align-items:center;gap:6px;padding:4px 12px;background:var(--accent-soft);border-radius:8px;font-family:var(--font-ui);font-weight:700;color:var(--accent);font-size:.82rem}
.timer-box.warning{background:#ffe4e8;color:#c44;animation:pulse 1s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.6}}
/* Quiz navigation buttons */
.qz-nav{display:flex;gap:8px;justify-content:center;margin-top:16px;flex-wrap:wrap}
.qz-nav button{padding:8px 18px;border-radius:8px;font-weight:700;font-size:.82rem;transition:all .2s}
.qz-nav .prev{background:var(--surface-2);color:var(--text-soft);border:1px solid var(--border)}
.qz-nav .prev:hover{background:var(--accent-soft);color:var(--accent)}
.qz-nav .next{background:var(--accent);color:#fff}
.qz-nav .next:hover{background:var(--accent-2)}
.qz-nav .goto{background:var(--accent-2);color:#fff}
.qz-nav .goto:hover{background:var(--accent)}
@media (max-width:768px){
  :root{--header-h:106px}
  main{margin-right:0}
  #sidebar{transform:translateX(100%);width:min(300px,85vw)}
  #sidebar.open{transform:translateX(0)}
  #sidebar-toggle{display:flex}
  .content-wrap{padding:0 12px}
  .search-wrap{display:none}
  .nav-btn{padding:5px 9px;font-size:.7rem}
  .brand small{display:none}
  .chapter-select{grid-template-columns:1fr}
  .match-grid{grid-template-columns:1fr}
  .chapter-header{position:static}
}
body.zen #sidebar{transform:translateX(100%)}
body.zen main{margin-right:0}
@media print{#sidebar,#top-bar,#progress-bar,.hdr-btn,#to-top,#loader,.main-nav,.copy-share,.bayt-actions,.icon-btn,.search-wrap{display:none!important}main{margin:0;padding:0}.matn-card,.nazm-card,.alfia-card,.qa-card{box-shadow:none;border:1px solid #ccc;break-inside:avoid}}
</style>
