      <div class="setting-row"><span class="setting-label">الحجم:</span><div class="setting-control">
        <button class="font-btn" onclick="changeFontSize(-1)">−</button><span id="fs-val" style="font-weight:700;color:var(--accent);min-width:50px;text-align:center">${SETTINGS.fontSize}px</span><button class="font-btn" onclick="changeFontSize(1)">+</button>
        <input type="range" min="13" max="26" value="${SETTINGS.fontSize}" id="fs-slider" style="flex:1;margin-right:10px;accent-color:var(--accent)">
      </div></div>
      <div class="preview-box"><div class="pv-title">معاينة</div>الكلامُ هو اللفظُ المركبُ المفيدُ بالوضعِ</div>
    </div>
    <div class="settings-card"><h3>🔤 نوع الخط</h3>
      <div class="setting-row"><span class="setting-label">الخط:</span>
        <select class="select-input" id="font-sel">${fonts.map(f=>`<option value="${f}" ${SETTINGS.fontFamily===f?'selected':''}>${fontNames[f]}</option>`).join('')}</select>
      </div>
    </div>
    <div class="settings-card"><h3>🎨 اللون</h3>
      <div class="setting-row"><span class="setting-label">اللون:</span><div class="color-swatches">
        ${colors.map(c=>`<div class="color-swatch ${SETTINGS.color===c.id?'active':''}" onclick="setColor('${c.id}')" title="${c.name}" style="background:linear-gradient(135deg,${c.c1},${c.c2})"></div>`).join('')}
      </div></div>
