      <div class="setting-row"><span class="setting-label">الوضع:</span>
        <div style="display:flex;gap:8px">
          <button class="mini-btn" onclick="setTheme('light')" style="${SETTINGS.theme==='light'?'background:var(--accent);color:#fff':''}">☀️ نهاري</button>
          <button class="mini-btn" onclick="setTheme('dark')" style="${SETTINGS.theme==='dark'?'background:var(--accent);color:#fff':''}">🌙 ليلي</button>
        </div>
