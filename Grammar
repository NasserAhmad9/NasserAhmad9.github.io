function changeFontSize(d){ SETTINGS.fontSize=Math.max(13,Math.min(26,SETTINGS.fontSize+d)); applySettings(); saveSettings(); const el=document.getElementById('fs-val'); if(el)el.textContent=SETTINGS.fontSize+'px'; const sl=document.getElementById('fs-slider'); if(sl)sl.value=SETTINGS.fontSize; }
function setColor(id){ SETTINGS.color=id; applySettings(); saveSettings(); renderSettings(); }
function setTheme(t){ SETTINGS.theme=t; applySettings(); saveSettings(); updateThemeIcons(); renderSettings(); }
function resetSettings(){ SETTINGS={...DEFAULT_SETTINGS}; applySettings(); saveSettings(); updateThemeIcons(); renderSettings(); showToast('تم إعادة الإعدادات'); }

/* ============================================================
   التنقل بين الصفحات
   ============================================================ */
function switchView(v){
  STATE.currentView = v;
  document.querySelectorAll('.view').forEach(x=>x.classList.remove('active'));
  document.getElementById(`view-${v}`).classList.add('active');
  document.querySelectorAll('.nav-btn').forEach(b=>b.classList.toggle('active', b.dataset.view===v));
  if(v==='reader') renderReader();
  else if(v==='favorites') renderFavorites();
  else if(v==='quiz') renderQuiz();
  else if(v==='games') renderGames();
  else if(v==='settings') renderSettings();
  window.scrollTo({top:0,behavior:'smooth'});
  document.getElementById('sidebar').style.display = v==='reader' ? '' : 'none';
  document.querySelector('main').style.marginRight = v==='reader' ? '' : '0';
}
function closeMobileSidebar(){ document.getElementById('sidebar').classList.remove('open'); document.getElementById('close-sidebar').style.display='none'; }
function updateThemeIcons(){ const d=SETTINGS.theme==='dark'; document.getElementById('icon-moon').style.display=d?'none':'block'; document.getElementById('icon-sun').style.display=d?'block':'none'; }

/* ============================================================
   التهيئة
   ============================================================ */
(function init(){
  loadSettings(); loadFavorites(); updateThemeIcons();
  const data = JSON.parse(document.getElementById('data').textContent);
  STATE.chapters = data.chapters;
  document.querySelectorAll('.nav-btn').forEach(btn=>btn.addEventListener('click', ()=>switchView(btn.dataset.view)));
  document.getElementById('theme-toggle').addEventListener('click', ()=>{ SETTINGS.theme=SETTINGS.theme==='dark'?'light':'dark'; applySettings(); saveSettings(); updateThemeIcons(); });
  document.getElementById('sidebar-toggle').addEventListener('click', ()=>{ const s=document.getElementById('sidebar'); const o=s.classList.toggle('open'); document.getElementById('close-sidebar').style.display=o?'flex':'none'; });
  document.getElementById('close-sidebar').addEventListener('click', closeMobileSidebar);
  document.getElementById('to-top').addEventListener('click', ()=>window.scrollTo({top:0,behavior:'smooth'}));
  document.addEventListener('keydown', e=>{ if(e.key==='Escape') closeMobileSidebar(); });
  renderReader();
  document.getElementById('loader').classList.add('hidden');
})();
</script>
