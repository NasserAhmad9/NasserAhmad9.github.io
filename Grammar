له إلا الله — محمدٌ صفوةُ المرسلين — الله ربنا — محمد نبينا."},{"q":"ما تقول في رجل كتب لك رسالة يحكي قصة رحلته إلى مكة، هل يسمى هذا كلامًا؟","a":"هذا ليس بكلام عند النحويين؛ لأنه ليس بلفظ."},{"q":"ما تقول فيما إذا قال لك شخص: «إن اجتهدت»، هل هذا كلام؟","a":"لا، ليس كلامًا؛ لأنه غير مفيد."}]},
{"id":"aqsam","title":"أقسام الكلام","matn":"وَأَقْسَامُهُ ثَلَاثَةٌ: اسْمٌ، وَفِعْلٌ، وَحَرْفٌ جَاءَ لِمَعْنًى.","nazm":[["أَقْسَامُهُ الَّتِي عَلَيْهَا يُبْنَى","اسْمٌ وَفِعْلٌ ثُمَّ حَرْفُ مَعْنَى"]],"alfia":[["وَاسْمٌ وَفِعْلٌ ثُمَّ حَرْفٌ وَالكَلِمْ","وَاحِدُهُ كَلِمَةٌ وَالقَوْلُ عَمْ"]],"qas":[{"q":"ما هو الاسم؟ مَثِّل بعشرة أمثلة.","a":"كلمة دلت على معنى في نفسها، ولم تقترن بزمان. مثاله: محمد، علي، رجلٌ، جملٌ، نهرٌ، تفاحةٌ، ليمونةٌ، عصا، فرس، ترك."},{"q":"ما هو الفعل؟ وإلى كم قسم ينقسم؟","a":"كلمة دلت على معنى في نفسها، واقترنت بأحد الأزمنة الثلاثة. وينقسم إلى ثلاثة: ماضٍ، ومضارع، وأمر."},{"q":"ما هو الحرف؟ مَثِّل بعشرة أمثلة.","a":"كلمة دلت على معنى في غيرها. من أمثلته: مِن، إلى، عن، على، إلا، لكن، إنَّ، إنْ، بلى، قد."},{"q":"ما الدليل على انحصار أقسام الكلام في ثلاثة؟","a":"التتبع والاستقراء؛ فالعلماء تتبعوا كلام العرب فوجدوه لا يخرج عن: الاسم والفعل والحرف."},{"q":"لماذا قيد المؤلف الحرف بقوله: «وحرف جاء لمعنى»؟","a":"احترازًا من الحرف الذي لم يأتِ لمعنى كالميم."}]},
{"id":"alamat-ism","title":"علامات الاسم","matn":"فَالاسْمُ يُعْرَفُ بِالخَفْضِ، وَالتَّنْوِينِ، وَدُخُولِ الأَلِفِ وَاللَّامِ عَلَيْهِ، وَحُرُوفِ الخَفْضِ، وَهِيَ: مِنْ، وَإِلَى، وَعَنْ، وَعَلَى، وَفِي، وَرُبَّ، وَحَتَّى، وَحَاشَا، وَمُذْ، وَمُنْذُ، وَالبَاءُ، وَالكَافُ، وَاللَّامُ، وَحُرُوفُ القَسَمِ، وَهِيَ: الوَاوُ، وَالبَاءُ، وَالتَّاءُ.","nazm":[["فَالاسْمُ بِالخَفْضِ وَبِالتَّنْوِينِ أَوْ","دُخُولِ أَلْ يُعْرَفُ فَاقْفُ مَا قَفَوْا"],["وَبِحُرُوفِ الخَفْضِ وَهْيَ مِنْ إِلَى","وَعَنْ وَفِي وَرُبَّ وَالبَاءِ وَعَلَى"],["وَالكَافِ وَاللَّامِ وَوَاوٍ وَالتَّا","وَمُذْ وَمُنْذُ وَلَعَلَّ حَتَّى"]],"alfia":[["بِالجَرِّ وَالتَّنْوِينِ وَالنِّدَا وَأَلْ","وَمُسْنَدٍ لِلِاسْمِ تَمْيِيزٌ حَصَلْ"]],"qas":[{"q":"ما هي علامات الاسم؟","a":"الخفض، والتنوين، ودخول الألف واللام، وحروف الخفض."},{"q":"ما هو الفرق بين الخفض والجر؟","a":"الخفض اصطلاح الكوفيين، والجر اصطلاح البصريين، ولا اختلاف بينهما من جهة المعنى."},{"q":"ما هي أنواع التنوين؟","a":"ستة: التمكين، والتنكير، والمقابلة، والعوض (عن حرف أو كلمة أو جملة)، والترنم، والغالي. ويختص الاسم بالأربعة الأولى."},{"q":"هل يجتمع التنوين والألف واللام؟","a":"لا يجتمعان أبدًا."},{"q":"على أي شيء تدل الحروف: مِن، اللام، الكاف، رُبَّ، عن، في؟","a":"مِن: الابتداء. اللام: الملك والاختصاص. الكاف: التشبيه. رُبَّ: التقليل/التكثير. عن: المجاوزة. في: الظرفية."}]},
{"id":"alamat-fil","title":"علامات الفعل","matn":"وَالفِعْلُ يُعْرَفُ بِقَدْ، وَالسِّينِ، وَسَوْفَ، وَتَاءِ التَّأْنِيثِ السَّاكِنَةِ.","nazm":[["وَالفِعْلُ بِالسِّينِ وَسَوْفَ وَبِقَدْ","فَاعْلَمْ وَنَا التَّأْنِيثِ مَيْزُهُ وَرَدْ"]],"alfia":[["وَنُونُ أَفْعَالِ الرُّبَاعِيِّ إِذَا","خُصَّتْ بِتَاءِ فَاعِلٍ وَقَدْ نُسِخَا"]],"qas":[{"q":"ما هي علامات الفعل؟","a":"قد، والسين، وسوف، وتاء التأنيث الساكنة."},{"q":"ما المعاني التي تدل عليها «قد»؟","a":"مع الماضي: التحقيق والتقريب. ومع المضارع: التقليل، والتكثير، والتحقيق."},{"q":"على أي شيء تدل تاء التأنيث الساكنة؟","a":"على أن الاسم الذي أُسند إليه الفعل مؤنث، سواء كان فاعلًا أو نائب فاعل."}]},
{"id":"irab","title":"باب الإعراب","matn":"الإِعْرَابُ هُوَ تَغْيِيرُ أَوَاخِرِ الكَلِمِ؛ لِاخْتِلَافِ العَوَامِلِ الدَّاخِلَةِ عَلَيْهَا، لَفْظًا أَوْ تَقْدِيرًا. وَأَقْسَامُهُ أَرْبَعَةٌ: رَفْعٌ، وَنَصْبٌ، وَخَفْضٌ، وَجَزْمٌ. فَلِلْأَسْمَاءِ مِنْ ذَلِكَ الرَّفْعُ، وَالنَّصْبُ، وَالخَفْضُ، وَلَا جَزْمَ. وَلِلْأَفْعَالِ مِنْ ذَلِكَ الرَّفْعُ، وَالنَّصْبُ، وَالجَزْمُ، وَلَا خَفْضَ.","nazm":[["الإِعْرَابُ تَغْيِيرُ أَوَاخِرِ الكَلِمْ","تَقْدِيرًا أَوْ لَفْظًا فَذَا الخَدَّ اغْتَنِمْ"],["وَذَلِكَ التَّغْيِيرُ لِاضْطِرَابِ","عَوَامِلٍ تَدْخُلُ لِلْإِعْرَابِ"],["أَقْسَامُهُ أَرْبَعَةٌ تُؤَمُّ","رَفْعٌ وَنَصْبٌ ثُمَّ خَفْضٌ جَزْمٌ"],["فَالْأَوَّلَانِ دُونَ رَيْبٍ وَقَعَا","فِي الاسْمِ وَالفِعْلِ المُضَارِعِ مَعَا"],["وَالاسْمُ قَدْ خُصِّصَ بِالخَفْضِ كَمَا","قَدْ خُصِّصَ الفِعْلُ بِجَزْمٍ فَاعْلَمَا"]],"alfia":[["الإِعْرَابُ تَغْيِيرُ أَوَاخِرِ الكَلِمْ","تَقْدِيرًا أَوْ لَفْظًا فَذَا الخَدَّ اغْتَنِمْ"]],"qas":[{"q":"ما هو الإعراب لغة واصطلاحًا؟","a":"لغةً: الإظهار والإبانة. اصطلاحًا: تغيير أواواخر الكلم لاختلاف العوامل الداخلة عليها، لفظًا أو تقديرًا."},{"q":"ما هو البناء لغة واصطلاحًا؟","a":"لغةً: وضع شيء على شيء للثبوت واللزوم. اصطلاحًا: لزوم آخر الكلمة حالة واحدة لغير عامل ولا اعتلال."},{"q":"ما هي حروف العلة؟","a":"الألف، والياء المكسور ما قبلها، والواو المضموم ما قبلها."},{"q":"ما هي أحكام حروف العلة؟","a":"الألف: تُقدَّر عليها جميع الحركات (التعذر). والياء والواو: تُقدَّر عليهما الضمة والكسرة (الثقل)، وتظهر الفتحة لخفتها."}]},
{"id":"anwa-irab","title":"أنواع الإعراب","matn":"وَأَقْسَامُهُ أَرْبَعَةٌ: رَفْعٌ، وَنَصْبٌ، وَخَفْضٌ، وَجَزْمٌ.","nazm":[["أَقْسَامُهُ أَرْبَعَةٌ تُؤَمُّ","رَفْعٌ وَنَصْبٌ ثُمَّ خَفْضٌ جَزْمٌ"]],"alfia":[["وَالاسْمُ قَدْ خُصِّصَ بِالخَفْضِ كَمَا","قَدْ خُصِّصَ الفِعْلُ بِجَزْمٍ فَاعْلَمَا"]],"qas":[{"q":"ما هي أقسام الإعراب؟","a":"أربعة: الرفع، والنصب، والخفض، والجزم."},{"q":"ما الدليل على انحصارها في هذه الأقسام الأربعة؟","a":"التتبع والاستقراء لكلام العرب."},{"q":"ما الذي يختص به الاسم؟","a":"الخفض، فلا يوجد فعل مخفوض."},{"q":"ما الذي يختص به الفعل؟","a":"الجزم، فلا يوجد اسم مجزوم."},{"q":"ما الأنواع المشتركة بين الاسم والفعل؟","a":"الرفع والنصب."}]},
{"id":"alamat-irab","title":"علامات الإعراب","matn":"لِلرَّفْعِ أَرْبَعُ عَلَامَاتٍ: الضَّمَّةُ، وَالوَاوُ، وَالأَلِفُ، وَالنُّونُ. وَلِلنَّصْبِ خَمْسُ عَلَامَاتٍ: الفَتْحَةُ، وَالأَلِفُ، وَالكَسْرَةُ، وَاليَاءُ، وَحَذْفُ النُّونِ. وَلِلخَفْضِ ثَلَاثُ عَلَامَاتٍ: الكَسْرَةُ، وَاليَاءُ، وَالفَتْحَةُ. وَلِلْجَزْمِ عَلَامَتَانِ: السُّكُونُ، وَالحَذْفُ.","nazm":[["ضَمٌّ وَوَاوٌ أَلِفٌ وَالنُّونُ","عَلَامَةُ الرَّفْعِ بِهَا تَكُونُ"],["عَلَامَةُ النَّصْبِ لَهَا كُنْ مُحْصِيَا","الفَتْحَ وَالأَلِفَ وَالكَسْرَ وَيَا"],["عَلَامَةُ الخَفْضِ الَّتِي بِهَا يَفِي","كَسْرٌ وَبَاءٌ ثُمَّ فَتْحٌ فَاقْتَفِ"],["إِنَّ السُّكُونَ يَا ذَوِي الأَذْهَانِ","وَالحَذْفَ لِلْجَزْمِ عَلَامَتَانِ"]],"alfia":[["وَلِلْمَرْفُوعَاتِ أَرْبَعُ عَلَامَاتٍ","فَاعْلَمْ وَالْأَصْلُ فِي ذَاكَ الضَّمُّ"]],"qas":[{"q":"كم علامات الرفع؟","a":"أربعة: الضمة، والواو، والألف، والنون."},{"q":"في كم موضع تكون الضمة علامة للرفع؟","a":"أربعة: الاسم المفرد، وجمع التكسير، وجمع المؤنث السالم، والفعل المضارع الذي لم يتصل بآخره شيء."},{"q":"متى يُرفع الفعل المضارع بالضمة؟","a":"إذا لم يتصل بآخره شيء (لا نون توكيد، ولا نون نسوة، ولا ألف اثنين، ولا واو جماعة، ولا ياء مخاطبة)."},{"q":"ما هي الأفعال الخمسة؟","a":"كل فعل مضارع اتصل بآخره ألف الاثنين، أو واو الجماعة، أو ياء المخاطبة."}]},
{"id":"muarabat","title":"فصل المعربات","matn":"المُعْرَبَاتُ قِسْمَانِ: قِسْمٌ يُعْرَبُ بِالحَرَكَاتِ، وَقِسْمٌ يُعْرَبُ بِالحُرُوفِ. فَالَّذِي يُعْرَبُ بِالحَرَكَاتِ أَرْبَعَةُ أَنْوَاعٍ: الاسْمُ المُفْرَدُ، وَجَمْعُ التَّكْسِيرِ، وَجَمْعُ المُؤَنَّثِ السَّالِمُ، وَالفِعْلُ المُضَارِعُ الَّذِي لَمْ يَتَّصِلْ بِآخِرِهِ شَيْءٌ. وَالَّذِي يُعْرَبُ بِالحُرُوفِ أَرْبَعَةُ أَنْوَاعٍ: التَّثْنِيَةُ، وَجَمْعُ المُذَكَّرِ السَّالِمُ، وَالأَسْمَاءُ الخَمْسَةُ، وَالأَفْعَالُ الخَمْسَةُ.","nazm":[],"alfia":[["وَالمُعْرَبَاتُ مِنَ الأَسْمَاءِ سِوَى","مَا مِنْهَا بِالحَرْفِ قَدْ جِيءَ بِهِ"]],"qas":[{"q":"إلى كم قسم تنقسم المعربات؟","a":"قسمان: ما يعرب بالحركات، وما يعرب بالحروف."},{"q":"ما المعربات التي تُعرب بالحركات؟","a":"أربعة: الاسم المفرد، وجمع التكسير، وجمع المؤنث السالم، والفعل المضارع الذي لم يتصل بآخره شيء."},{"q":"ما المعربات التي تُعرب بالحروف؟","a":"أربعة: التثنية، وجمع المذكر السالم، والأسماء الخمسة، والأفعال الخمسة."}]},
{"id":"afal","title":"باب الأفعال","matn":"الأَفْعَالُ ثَلَاثَةٌ: مَاضٍ، وَمُضَارِعٌ، وَأَمْرٌ، نَحْوُ: ضَرَبَ، يَضْرِبُ، اضْرِبْ. فَالمَاضِي مَفْتُوحُ الآخِرِ أَبَدًا. وَالأَمْرُ مَجْزُومٌ أَبَدًا. وَالمُضَارِعُ مَا كَانَ فِي أَوَّلِهِ إِحْدَى الزَّوَائِدِ الأَرْبَعِ الَّتِي يَجْمَعُهَا قَوْلُكَ: «أَنَيْتُ»، وَهُوَ مَرْفُوعٌ أَبَدًا حَتَّى يَدْخُلَ عَلَيْهِ نَاصِبٌ أَوْ جَازِمٌ.","nazm":[["وَهْيَ ثَلَاثَةٌ مُضِيٌّ قَدْ خَلَا","وَفِعْلُ أَمْرٍ وَمُضَارِعٌ عَلَا"],["فَابْنِ عَلَى الفَتْحِ المُضِيَّ أَبَدًا","وَالأَمْرُ بِالجَزْمِ لَدَى البَعْضِ ارْتَدَى"],["ثُمَّ المُضَارِعُ الَّذِي فِي صَدْرِهِ","إِحْدَى زَوَائِدِ أَنَيْتَ فَادْرِهِ"],["وَحُكْمُهُ الرَّفْعُ إِذَا يُجَرَّدُ","مِنْ نَاصِبٍ وَجَازِمٍ كَتَسْعَدُ"]],"alfia":[["فِعْلٌ مُضَارِعٌ يَلِيهِ نَاصِبُ","أَوْ جَازِمٌ أَوْ مَا لَهُ مُلَابِسُ"]],"qas":[{"q":"إلى كم قسم ينقسم الفعل؟","a":"ثلاثة: ماضٍ، ومضارع، وأمر."},{"q":"ما هو الفعل الماضي؟","a":"ما يدل على حصول شيء قبل زمن التكلم؛ نحو: ضرب، نصر، فتح، علم."},{"q":"ما هو الفعل المضارع؟","a":"ما يدل على حصول شيء في زمن التكلم أو بعده."},{"q":"ما هو فعل الأمر؟","a":"ما يُطلب به حصول شيء بعد زمن التكلم."},{"q":"متى يكون الفعل الماضي مبنيًا على الفتح الظاهر؟","a":"في موضعين: الصحيح الآخر الذي لم يتصل به واو جماعة ولا ضمير رفع متحرك، وكل فعل ماضٍ آخره واو أو ياء."},{"q":"ما هي علامة الفعل المضارع؟","a":"منفصلة (لم، السين، سوف)، ومتصلة (أن يكون في أوله إحدى زوائد «أنيت»)."}]},
{"id":"nawasib","title":"نواصب المضارع","matn":"فَالنَّوَاصِبُ عَشَرَةٌ، وَهِيَ: أَنْ، وَلَنْ، وَإِذَنْ، وَكَيْ، وَلَامُ كَيْ، وَلَامُ الجُحُودِ، وَحَتَّى، وَالجَوَابُ بِالفَاءِ، وَالوَاوِ، وَأَوْ.","nazm":[["فَنَصْبُهُ بِأَنْ وَلَنْ إِذَنْ وَكَيْ","وَلَامِ كَيْ لَامِ الجُحُودِ يَا أُخَيْ"],["كَذَاكَ حَتَّى وَالجَوَابُ بِالفَا","وَالهَاءِ ثُمَّ أَوْ رُزِقْتَ اللُّطْفَا"]],"alfia":[["وَنَصْبُهُمْ بِأَنْ وَلَنْ وَكَيْ وَإِذْ","وَلَامِ كَيْ لَامِ الجُحُودِ يَا أُخَيْ"]],"qas":[{"q":"ما الأدوات التي تنصب المضارع بنفسها؟","a":"أن، ولن، وإذن، وكي."},{"q":"ما الذي يشترط لنصب المضارع بعد «إذن»؟","a":"ثلاثة: أن تكون في صدر جملة الجواب، ومتصلة بالفعل، والفعل دال على الاستقبال."},{"q":"متى تنصب «أن» مضمرة جوازًا؟","a":"بعد لام كي."},{"q":"متى تنصب «أن» مضمرة وجوبًا؟","a":"بعد: لام الجحود، وحتى، وفاء السببية، وواو المعية، وأو."}]},
{"id":"jawazim","title":"جوازم المضارع","matn":"وَالجَوَازِمُ ثَمَانِيَةَ عَشَرَ، وَهِيَ: لَمْ، وَلَمَّا، وَأَلَمْ، وَأَلَمَّا، وَلَامُ الأَمْرِ وَالدُّعَاءِ، وَ«لَا» فِي النَّهْيِ وَالدُّعَاءِ، وَإِنْ، وَمَا، وَمَنْ، وَمَهْمَا، وَإِذْمَا، وَأَيُّ، وَمَتَى، وَأَيَّانَ، وَأَيْنَ، وَأَنَّى، وَحَيْثُمَا، وَكَيْفَمَا، وَإِذَا فِي الشِّعْرِ خَاصَّةً.","nazm":[["وَجَزْمُهُ إِذَا أَرَدْتَ الجَزْمَا","بِلَمْ وَلَمَّا وَأَلَمْ أَلَمَّا"],["وَلَامِ الأَمْرِ وَالدُّعَاءِ ثُمَّ لَا","فِي النَّهْيِ وَالدُّعَاءِ نِلْتَ الأَمَلَا"],["وَإِنْ وَمَا وَمَنْ وَأَنَّى مَهْمَا","أَيٌّ مَتَى أَيَّانَ أَيْنَ إِذْمَا"],["وَحَيْثُمَا وَكَيْفَمَا ثُمَّ إِذَا","فِي الشِّعْرِ لَا فِي النَّثْرِ فَادْرِ المَأْخَذَا"]],"alfia":[["وَجَزْمُهُمْ بِلَمْ وَلَمَّا وَأَلَمْ","وَلَامِ كَيْ لَامِ الجُحُودِ يَا أُخَيْ"]],"qas":[{"q":"إلى كم قسم تنقسم الجوازم؟","a":"قسمان: ما يجزم فعلًا واحدًا، وما يجزم فعلين."},{"q":"ما الجوازم التي تجزم فعلًا واحدًا؟","a":"ستة: لم، ولما، وألم، وألما، ولام الأمر والدعاء، و«لا» في النهي والدعاء."},{"q":"ما الجوازم التي تجزم فعلين؟","a":"اثنا عشر: إن، ما، مهما، إذما، أي، متى، أين، أنى، أيان، حيثما، كيفما، من."}]},
{"id":"marfuat","title":"مرفوعات الأسماء","matn":"المَرْفُوعَاتُ سَبْعَةٌ، وَهِيَ: الفَاعِلُ، وَالمَفْعُولُ الَّذِي لَمْ يُسَمَّ فَاعِلُهُ، وَالمُبْتَدَأُ، وَخَبَرُهُ، وَاسْمُ كَانَ وَأَخَوَاتِهَا، وَخَبَرُ إِنَّ وَأَخَوَاتِهَا، وَالتَّابِعُ لِلْمَرْفُوعِ.","nazm":[],"alfia":[["وَالمَرْفُوعَاتُ سَبْعَةٌ","فَاعِلٌ وَمَفْعُولٌ لَمْ يُسَمَّ فَاعِلُهْ"]],"qas":[{"q":"في كم موضع يكون الاسم مرفوعًا؟","a":"سبعة: الفاعل، ونائب الفاعل، والمبتدأ، والخبر، واسم كان، وخبر إن، وتابع المرفوع."},{"q":"ما أنواع التوابع؟","a":"أربعة: النعت، والعطف، والتوكيد، والبدل."}]},
{"id":"fail","title":"باب الفاعل","matn":"الفَاعِلُ هُوَ الاسْمُ المَرْفُوعُ المَذْكُورُ قَبْلَهُ فِعْلُهُ. وَهُوَ عَلَى قِسْمَيْنِ: ظَاهِرٌ، وَمُضْمَرٌ.","nazm":[["الفَاعِلَ ارْفَعْ وَهْوَ مَا قَدْ أُسْنِدَا","إِلَيْهِ فِعْلٌ قَبْلَهُ قَدْ وُجِدَا"],["وَظَاهِرًا يَأْتِي وَيَأْتِي مُضْمَرًا","كَأَصْطَادَ زَيْدٌ وَأَشْتَرَيْتُ أَعْفَرَا"]],"alfia":[["وَالْفَاعِلُ الَّذِي كَفِعْلٍ أُسْنِدَا","وَقَدْ يَكُونُ ظَاهِرًا وَمُضْمَرَا"]],"qas":[{"q":"ما هو الفاعل؟","a":"اصطلاحًا: الاسم المرفوع المذكور قبله فعله."},{"q":"هل يمكن أن يكون الفاعل منصوبًا؟","a":"لا؛ لأن الفاعل هو الاسم المرفوع."},{"q":"هل يتقدم الفاعل على فعله؟","a":"لا؛ لأن الفاعل مذكور قبله فعله، فإن تقدم كان مبتدأً لا فاعلًا."},{"q":"إلى كم قسم ينقسم الفاعل؟","a":"قسمان: ظاهر ومضمر. والمضمر: متصل ومنفصل."}]},
{"id":"naib-fail","title":"نائب الفاعل","matn":"المَفْعُولُ الَّذِي لَمْ يُسَمَّ فَاعِلُهُ هُوَ الاسْمُ المَرْفُوعُ الَّذِي لَمْ يُذْكَرْ مَعَهُ فَاعِلُهُ. فَإِنْ كَانَ الفِعْلُ مَاضِيًا ضُمَّ أَوَّلُهُ وَكُسِرَ مَا قَبْلَ آخِرِهِ، وَإِنْ كَانَ مُضَارِعًا ضُمَّ أَوَّلُهُ وَفُتِحَ مَا قَبْلَ آخِرِهِ.","nazm":[["إِذَا حَذَفْتَ فِي الكَلَامِ فَاعِلَا","مُخْتَصَرًا أَوْ مُبْهَمًا أَوْ جَاهِلَا"],["فَأَوْجِبِ التَّأْخِيرَ لِلْمَفْعُولِ بِهْ","وَارْفَعْ حَيْثُ نَابَ عَنْهُ فَانْتَبِهْ"]],"alfia":[["وَالْمَفْعُولُ الَّذِي لَمْ يُسَمَّ فَاعِلُهُ","مَرْفُوعٌ وَالثَّانِي مَنْصُوبٌ"]],"qas":[{"q":"ما الذي تفعله في الفعل عند إسناده للنائب عن الفاعل؟","a":"الماضي: ضم أوله وكسر ما قبل آخره. المضارع: ضم أوله وفتح ما قبل آخره."},{"q":"ما الذي تفعله في المفعول إذا أقمته مقام الفاعل؟","a":"ترفعه بعد أن كان منصوبًا، وتُعطيه أحكام الفاعل."}]},
{"id":"mubtada","title":"المبتدأ والخبر","matn":"المُبْتَدَأُ هُوَ الاسْمُ المَرْفُوعُ العَارِي عَنِ العَوَامِلِ اللَّفْظِيَّةِ. وَالخَبَرُ هُوَ الاسْمُ المَرْفُوعُ المُسْنَدُ إِلَيْهِ.","nazm":[["المُبْتَدَا اسْمٌ مِنْ عَوَامِلٍ سَلِمَ","لَفْظِيَّةٍ وَهُوَ بِرَفْعٍ قَدْ وُسِمَ"],["وَالخَبَرُ الاسْمُ الَّذِي قَدْ أُسْنِدَا","إِلَيْهِ وَالرَّفْعَ الْتَزِمْهُ أَبَدَا"]],"alfia":[["مُبْتَدَأٌ زَائِدٌ مُسْنَدٌ إِلَيْهْ","وَالْخَبَرُ الْمُسْنَدُ نَفْعًا فِيهِ"]],"qas":[{"q":"ما هو المبتدأ؟ وما هو الخبر؟","a":"المبتدأ: الاسم المرفوع العاري عن العوامل اللفظية. الخبر: الاسم المرفوع المسند إليه."},{"q":"ما الذي يربط الخبر الجملة بالمبتدأ؟","a":"ضمير يعود على المبتدأ، أو إشارة إليه، أو إعادة المبتدأ بلفظه، أو لفظ عام يشتمل عليه."},{"q":"في أي شيء تجب مطابقة الخبر للمبتدأ؟","a":"في التذكير والتأنيث، والجمع والإفراد والتثنية."}]},
{"id":"nawasikh","title":"النواسخ","matn":"العَوَامِلُ الدَّاخِلَةُ عَلَى المُبْتَدَأِ وَالخَبَرِ ثَلَاثَةُ أَشْيَاءَ: كَانَ وَأَخَوَاتُهَا، وَإِنَّ وَأَخَوَاتُهَا، وَظَنَنْتُ وَأَخَوَاتُهَا.","nazm":[["وَرَفْعُكَ الاسْمَ وَنَصْبُكَ الخَبَرْ","بِهَذِهِ الأَفْعَالِ حُكْمٌ مُعْتَبَرْ"],["عَمَلُ كَانَ عَكْسُهُ لِإِنَّ أَنْ","لَكِنَّ لَيْتَ وَلَعَلَّ وَكَأَنْ"],["أَنْصِبْ بِأَفْعَالِ القُلُوبِ مُبْتَدَا","وَخَبَرًا وَهْيَ ظَنَنْتُ وَجَدَا"]],"alfia":[["وَكَانَ وَأَخَوَاتُهَا تَرْفَعُ الِاسْمَ","وَتَنْصِبُ الْخَبَرَ وَهَذَا حُكْمُهَا"],["وَإِنَّ وَأَخَوَاتُهَا تَنْصِبُ الِاسْمَ","وَتَرْفَعُ الْخَبَرَ وَهَذَا رَسْمُهَا"]],"qas":[{"q":"إلى كم قسم تنقسم النواسخ؟","a":"ثلاثة: كان وأخواتها، وإن وأخواتها، وظننت وأخواتها."},{"q":"ما الذي تعمله «كان» وأخواتها؟","a":"ترفع المبتدأ (اسمها) وتنصب الخبر (خبرها)."},{"q":"ما الذي تعمله «إنَّ» وأخواتها؟","a":"تنصب المبتدأ (اسمها) وترفع الخبر (خبرها)."},{"q":"ما الذي تعمله «ظننت» وأخواتها؟","a":"تنصب المبتدأ والخبر على أنهما مفعولان لها."}]},
{"id":"naat","title":"باب النعت","matn":"النَّعْتُ تَابِعٌ لِمَنْعُوتِهِ فِي رَفْعِهِ، وَنَصْبِهِ، وَخَفْضِهِ، وَتَعْرِيفِهِ، وَتَنْكِيرِهِ.","nazm":[["النَّعْتُ قَدْ قَالَ ذَوُو الأَلْبَابِ","يَتْبَعُ لِلْمَنْعُوتِ فِي الإِعْرَابِ"]],"alfia":[["يَتْبَعُ فِي الْإِعْرَابِ وَالتَّعْرِيفِ","وَالنَّكِرَاتِ وَالتَّذْكِيرِ وَالتَّأْنِيثِ"]],"qas":[{"q":"ما هو النعت؟","a":"التابع المشتق أو المؤول بالمشتق، لاسم يتبعه في الإعراب والتعريف والتنكير."},{"q":"إلى كم قسم ينقسم النعت؟","a":"قسمان: الحقيقي، والسببي."},{"q":"ما هي المعرفة؟","a":"خمسة: الضمير، والعلم، واسم الإشارة، والاسم المعرف بالألف واللام، وما أضيف إلى واحد منها."},{"q":"ما هي النكرة؟","a":"كل اسم شائع في جنسه لا يختص به واحد دون آخر، وصلح لدخول الألف واللام عليه."}]},
{"id":"atf","title":"باب العطف","matn":"حُرُوفُ العَطْفِ عَشَرَةٌ: الوَاوُ، وَالفَاءُ، وَثُمَّ، وَأَوْ، وَأَمْ، وَإِمَّا، وَبَلْ، وَلَا، وَلَكِنْ، وَحَتَّى فِي بَعْضِ المَوَاضِعِ.","nazm":[["هَذَا وَإِنَّ العَطْفَ أَيْضًا تَابِعُ","حُرُوفُهُ عَشَرَةٌ يَا سَامِعُ"]],"alfia":[["وَحُرُوفُ الْعَطْفِ عَشَرَةٌ","الْوَاوُ وَالْفَاءُ وَثُمَّ وَأَوْ"]],"qas":[{"q":"ما هي حروف العطف؟","a":"الواو، الفاء، ثم، أو، أم، إما، بل، لا، لكن، حتى في بعض المواضع."},{"q":"فيم يشترك المعطوف والمعطوف عليه؟","a":"في الحكم الإعرابي، فالمعطوف تابع للمعطوف عليه."}]},
{"id":"tawkid","title":"باب التوكيد","matn":"التَّوْكِيدُ تَابِعٌ لِلْمُؤَكَّدِ فِي رَفْعِهِ، وَنَصْبِهِ، وَخَفْضِهِ، وَتَعْرِيفِهِ. وَيَكُونُ بِأَلْفَاظٍ مَعْلُومَةٍ، وَهِيَ: النَّفْسُ، وَالعَيْنُ، وَكُلٌّ، وَأَجْمَعُ، وَتَوَابِعُ أَجْمَعَ.","nazm":[["وَيَتْبَعُ المُؤَكَّدَ التَّوْكِيدُ فِي","رَفْعٍ وَنَصْبٍ ثُمَّ خَفْضٍ فَاعْرِفِ"]],"alfia":[["وَالنَّفْسُ وَالْعَيْنُ وَكُلٌّ وَأَجْمَعُ","وَتَابِعُ الْأَجْمَعِ وَالْأَبْتَعُ"]],"qas":[{"q":"ما هو التوكيد؟","a":"التابع المقوي لمتبوعه. وهو قسمان: لفظي، ومعنوي."},{"q":"ما الألفاظ التي تستعمل في التوكيد المعنوي؟","a":"النفس، والعين، وكل، وأجمع، وتوابع أجمع: أكتع، وأبتع، وأبصع."}]},
{"id":"badal","title":"باب البدل","matn":"إِذَا أُبْدِلَ اسْمٌ مِنَ اسْمٍ، أَوْ فِعْلٌ مِنْ فِعْلٍ، تَبِعَهُ فِي جَمِيعِ إِعْرَابِهِ. وَهُوَ عَلَى أَرْبَعَةِ أَقْسَامٍ: بَدَلُ الشَّيْءِ مِنَ الشَّيْءِ، وَبَدَلُ البَعْضِ مِنَ الكُلِّ، وَبَدَلُ الاشْتِمَالِ، وَبَدَلُ الغَلَطِ.","nazm":[["إِذَا اسْمٌ أُبْدِلَ مِنْ اسْمٍ يُنْحَلْ","إِعْرَابَهُ وَالفِعْلُ أَيْضًا يُبْدَلْ"]],"alfia":[["وَالْبَدَلُ الْمُبْدَلُ مِنْهُ مَا","مِنْهُ بِحُكْمِ الْإِعْرَابِ قَدْ حُكِمَا"]],"qas":[{"q":"ما هو البدل؟","a":"التابع المقصود بالحكم بلا واسطة بينه وبين متبوعه."},{"q":"إلى كم قسم ينقسم البدل؟","a":"أربعة: بدل كل من كل، وبدل بعض من كل، وبدل اشتمال، وبدل غلط."},{"q":"ما الذي يشترط في بدل البعض وبدل الاشتمال؟","a":"أن يضاف إلى ضمير عائد إلى المبدل منه."}]},
{"id":"mafool-bih","title":"المفعول به","matn":"المَفْعُولُ بِهِ هُوَ الاسْمُ المَنْصُوبُ الَّذِي يَقَعُ بِهِ الفِعْلُ. وَهُوَ قِسْمَانِ: ظَاهِرٌ، وَمُضْمَرٌ.","nazm":[["مَهْمَا تَرَى اسْمًا وَقَعَ الفِعْلُ بِهِ","فَذَاكَ مَفْعُولٌ فَقُلْ بِنَصْبِهِ"]],"alfia":[["وَالْمَفْعُولُ بِهِ مَنْصُوبٌ","وَهُوَ الَّذِي يَقَعُ بِهِ الْفِعْلُ"]],"qas":[{"q":"ما هو المفعول به؟","a":"الاسم المنصوب الذي يقع عليه فعل الفاعل."},{"q":"إلى كم قسم ينقسم المفعول به؟","a":"قسمان: ظاهر ومضمر."},{"q":"ما الذي يجب أن يفصل بين الفعل وياء المتكلم؟","a":"نون تسمى نون الوقاية."}]},
{"id":"masdar","title":"باب المصدر","matn":"المَصْدَرُ هُوَ الاسْمُ المَنْصُوبُ الَّذِي يَجِيءُ ثَالِثًا فِي تَصْرِيفِ الفِعْلِ، نَحْوُ: ضَرَبَ، يَضْرِبُ، ضَرْبًا.","nazm":[["المَصْدَرُ اسْمٌ جَاءَ ثَالِثًا لَدَى","تَصْرِيفِ فِعْلٍ وَانْتِصَابُهُ بَدَا"]],"alfia":[["بِفِعْلِهِ مَصْدَرٌ مُنْصَبٌّ","وَمَا يَكُونُ بَعْدَهُ مَنْصُوبًا"]],"qas":[{"q":"ما هو المصدر؟ وما هو المفعول المطلق؟","a":"المصدر: الاسم المنصوب الذي يجيء ثالثًا في تصريف الفعل. المفعول المطلق: ما دل على تأكيد عامله أو نوعه أو عدده."},{"q":"إلى كم قسم ينقسم المفعول المطلق من جهة ما يراد منه؟","a":"ثلاثة: المؤكد لعامله، والمبين لنوع العامل، والمبين للعدد."}]},
{"id":"zarf","title":"ظرف الزمان والمكان","matn":"ظَرْفُ الزَّمَانِ هُوَ اسْمُ الزَّمَانِ المَنْصُوبُ بِتَقْدِيرِ «فِي». وَظَرْفُ المَكَانِ هُوَ اسْمُ المَكَانِ المَنْصُوبُ بِتَقْدِيرِ «فِي».","nazm":[["الظَّرْفُ مَنْصُوبٌ عَلَى إِضْمَارِ فِي","وَزَمَنِيًّا وَمَكَانِيًّا يَفِي"]],"alfia":[["وَالظَّرْفُ يَكُونُ زَمَانًا وَمَكَانًا","وَكُلُّهُمَا مَنْصُوبٌ عَلَى الظَّرْفِيَّةِ"]],"qas":[{"q":"ما هو الظرف؟","a":"هو المفعول فيه. وينقسم إلى ظرف زمان وظرف مكان."},{"q":"ما هو ظرف الزمان؟","a":"الاسم الدال على الزمان المنصوب بتقدير «في»."},{"q":"ما هو ظرف المكان المبهم؟ وما هو المختص؟","a":"المبهم: ما ليس له صورة ولا حدود محصورة. المختص: ما له صورة وحدود محصورة."},{"q":"هل ينصب كل ظرف مكان على المفعول فيه؟","a":"لا، المبهم فقط. وأما المختص فيجب جره بحرف جر."}]},
{"id":"hal","title":"باب الحال","matn":"الحَالُ هُوَ الاسْمُ المَنْصُوبُ، المُفَسِّرُ لِمَا انْبَهَمَ مِنَ الهَيْئَاتِ. وَلَا يَكُونُ الحَالُ إِلَّا نَكِرَةً، وَلَا يَكُونُ إِلَّا بَعْدَ تَمَامِ الكَلَامِ، وَلَا يَكُونُ صَاحِبُهَا إِلَّا مَعْرِفَةً.","nazm":[["الحَالُ لِلْهَيْئَاتِ أَيْ لِمَا انْبَهَمْ","مِنْهَا مُفَسِّرٌ وَنَصْبُهُ أُحْتِمْ"]],"alfia":[["وَالْحَالُ مَنْصُوبٌ وَهُوَ مَا","يُبَيِّنُ الْهَيْئَةَ وَالْحَالِيَّةَ"]],"qas":[{"q":"ما هو الحال؟","a":"الاسم الفضلة المنصوب المفسر لما استبهم من الهيئات."},{"q":"ما الذي يشترط في الحال؟","a":"أن يكون نكرة، وأن تجيء بعد تمام الكلام."},{"q":"ما الذي يشترط في صاحب الحال؟","a":"أن يكون معرفة، فلا يجوز أن يكون نكرة بغير مسوغ."},{"q":"ما هو ضابط الحال؟","a":"هي التي تقع في جواب «كيف»."}]},
{"id":"tamyiz","title":"باب التمييز","matn":"التَّمْيِيزُ هُوَ الاسْمُ المَنْصُوبُ، المُفَسِّرُ لِمَا انْبَهَمَ مِنَ الذَّوَاتِ. وَلَا يَكُونُ إِلَّا نَكِرَةً، وَلَا يَكُونُ إِلَّا بَعْدَ تَمَامِ الكَلَامِ.","nazm":[["اسْمٌ مُفَسِّرٌ لِمَا قَدِ انْبَهَمْ","مِنَ الذَّوَاتِ بِاسْمِ تَمْيِيزٍ رُسِمْ"]],"alfia":[["وَالْمَنْصُوبُ مِنَ الْأَسْمَاءِ مَا","يُفَسِّرُ الذَّاتَ وَيُبْدِي مَا"]],"qas":[{"q":"ما هو التمييز؟","a":"الاسم الصريح المنصوب المفسر لما استبهم من الذوات أو النسب."},{"q":"إلى كم قسم ينقسم؟","a":"قسمان: تمييز الذات، وتمييز النسبة."},{"q":"ما الفرق بين التمييز والحال؟","a":"التمييز مفسر للذوات، والحال مفسر للهيئات."},{"q":"ما هو العدد الذي ينصب تمييزه؟","a":"من أحد عشر إلى تسعة وتسعين وما بينهما."}]},
{"id":"istithna","title":"باب الاستثناء","matn":"حُرُوفُ الاسْتِثْنَاءِ ثَمَانِيَةٌ، وَهِيَ: إِلَّا، وَغَيْرُ، وَسِوَى، وَسُوَى، وَسَوَاءٌ، وَخَلَا، وَعَدَا، وَحَاشَا.","nazm":[["إِلَّا وَغَيْرٌ وَسِوَى سُوَى سَوَا","خَلَا عَدَا وَحَاشَ الاسْتِثْنَا حَوَى"]],"alfia":[["وَالْمُسْتَثْنَى مَنْصُوبٌ","بِإِلَّا أَوْ غَيْرِهَا مِنَ الْأَدَوَاتِ"]],"qas":[{"q":"ما أدوات الاستثناء؟","a":"ثمانية: إلا، وغير، وسوى، وسوى، وسواء، وخلا، وعدا، وحاشا."},{"q":"كم حالة للاسم الواقع بعد «إلا»؟","a":"ثلاثة: وجوب النصب، وجواز الإتباع بدلًا مع جواز النصب، ووجوب الإجراء على حسب العامل (في الناقص)."},{"q":"ما هو الكلام التام؟ وما هو الناقص؟","a":"التام: ما ذُكر فيه المستثنى منه. الناقص: ما لم يُذكر فيه."},{"q":"ما حكم الاسم بعد «سوى» و«غير»؟","a":"يجب جره بالإضافة إليه."}]},
{"id":"la","title":"لا النافية للجنس","matn":"«لَا» تَنْصِبُ النَّكِرَةَ بِغَيْرِ تَنْوِينٍ إِذَا بَاشَرَتِ النَّكِرَةَ وَلَمْ تَتَكَرَّرْ «لَا»، نَحْوُ: لَا رَجُلَ فِي الدَّارِ.","nazm":[["أَنْصِبْ بِلَا مُنَكَّرًا مُتَّصِلَا","مِنْ غَيْرِ تَنْوِينٍ إِذَا أُفْرِدَتْ لَا"]],"alfia":[["وَلَا لِنَفْيِ الْجِنْسِ تَعْمَلُ عَمَلَ إِنَّ","فَاسْمًا تَنْصِبُ وَخَبَرًا تَرْفَعُ"]],"qas":[{"q":"ما الذي تعمله «لا» النافية للجنس؟","a":"تعمل عمل «إنَّ» فتنصب الاسم وترفع الخبر."},{"q":"ما شروط وجوب عملها؟","a":"أربعة: أن يكون اسمها نكرة، ومتصلًا بها، وخبرها نكرة، وألا تتكرر."},{"q":"إلى كم قسم ينقسم اسم «لا»؟","a":"ثلاثة: المفرد، والمضاف إلى نكرة، والشبيه بالمضاف."},{"q":"ما حكم اسم «لا» المفرد؟","a":"يُبنى على ما يُنصب به."},{"q":"ما الحكم إذا تكررت «لا»؟","a":"جاز إعمالها وإهمالها."}]},
{"id":"munada","title":"باب المنادى","matn":"المُنَادَى خَمْسَةُ أَنْوَاعٍ: المُفْرَدُ العَلَمُ، وَالنَّكِرَةُ المَقْصُودَةُ، وَالنَّكِرَةُ غَيْرُ المَقْصُودَةِ، وَالمُضَافُ، وَالمُشَبَّهُ بِالمُضَافِ.","nazm":[["إِنَّ المُنَادَى فِي الكَلَامِ يَأْتِي","خَمْسَةَ أَنْوَاعٍ لَدَى النُّحَاةِ"]],"alfia":[["وَالمُنَادَى خَمْسَةٌ","مُفْرَدُ عَلَمٍ وَنَكِرَةٌ مُقْصَدَهْ"]],"qas":[{"q":"ما هي أدوات النداء؟","a":"يا، والهمزة، وأي، وأيا، وهيا."},{"q":"إلى كم قسم ينقسم المنادى؟","a":"خمسة: المفرد العلم، والنكرة المقصودة، والنكرة غير المقصودة، والمضاف، والشبيه بالمضاف."},{"q":"ما حكم المنادى المفرد العلم والمضاف؟","a":"المفرد العلم يُبنى على ما يُرفع به، والمضاف يُنصب وجوبًا."}]},
{"id":"mafool-ajlih","title":"المفعول من أجله","matn":"المَفْعُولُ مِنْ أَجْلِهِ هُوَ الاسْمُ المَنْصُوبُ الَّذِي يُذْكَرُ بَيَانًا لِسَبَبِ وُقُوعِ الفِعْلِ.","nazm":[["وَهُوَ الَّذِي جَاءَ بَيَانًا لِسَبَبْ","كَيْنُونَةِ العَامِلِ فِيهِ وَانْتَصَبْ"]],"alfia":[["وَالْمَفْعُولُ لِأَجْلِهِ مَنْصُوبٌ","بِشَرْطِ أَنْ يَكُونَ مَصْدَرًا"]],"qas":[{"q":"ما هو المفعول لأجله؟","a":"الاسم المنصوب الذي يُذكر بيانًا لسبب وقوع الفعل."},{"q":"ما شروط الاسم الذي يقع مفعولًا لأجله؟","a":"خمسة: مصدر، وقلبي، وعلة لما قبله، ومتحد مع عامله في الوقت، ومتحد معه في الفاعل."},{"q":"كم حالة له؟","a":"ثلاثة: مقترن بـ«أل»، أو مضاف، أو مجرد."}]},
{"id":"mafool-maah","title":"المفعول معه","matn":"المَفْعُولُ مَعَهُ هُوَ الاسْمُ المَنْصُوبُ الَّذِي يُذْكَرُ لِبَيَانِ مَنْ فُعِلَ مَعَهُ الفِعْلُ.","nazm":[["وَهُوَ اسْمٌ انْتَصَبَ بَعْدَ وَاوِ","مَعِيَّةٍ فِي قَوْلِ كُلِّ رَاوِ"]],"alfia":[["وَالْمَفْعُولُ مَعَهُ مَنْصُوبٌ","بَعْدَ وَاوٍ تُفِيدُ الْمَعِيَّةَ"]],"qas":[{"q":"ما هو المفعول معه؟","a":"الاسم الفضلة المنصوب بعد واو تفيد المعية نصًا، الدال على الذات التي وقع الفعل بمصاحبتها."},{"q":"إلى كم قسم ينقسم؟","a":"قسمان: ما يتعين نصبه، وما يجوز نصبه وإتباعه لما قبله معطوفًا عليه."}]},
{"id":"makhfudat","title":"باب المخفوضات","matn":"المَخْفُوضَاتُ ثَلَاثَةُ أَنْوَاعٍ: مَخْفُوضٌ بِالحَرْفِ، وَمَخْفُوضٌ بِالإِضَافَةِ، وَتَابِعٌ لِلْمَخْفُوضِ.","nazm":[["الخَفْضُ بِالحَرْفِ وَبِالإِضَافَةِ","كَمِثْلِ أَكْرِمْ بِأَبِي قُحَافَةَ"]],"alfia":[["وَالْخَفْضُ بِالْحَرْفِ وَبِالْإِضَافَةِ","وَبِالتَّبَعِيَّةِ الَّتِي قَدْ خُصَّتِ"]],"qas":[{"q":"على كم نوع تتنوع المخفوضات؟","a":"ثلاثة: بالحرف، وبالإضافة، وبالتبعية. وزاد بعضهم: بالمجاورة."},{"q":"ما المعنى الذي تدل عليه: مِن، عن، في، رُبَّ، الكاف، اللام؟","a":"مِن: الابتداء والتبعيض والتعليل. عن: المجاوزة. في: الظرفية. رُبَّ: التقليل/التكثير. الكاف: التشبيه. اللام: الملك والاختصاص."},{"q":"على كم نوع تأتي الإضافة؟","a":"ثلاثة: على معنى «مِن»، وعلى معنى «في»، وعلى معنى اللام."}]}
]}
</script>

<script>
/* ============================================================
   الحالة والإعدادات
   ============================================================ */
const STATE = {chapters:[], currentChapter:0, currentView:'reader', searchQuery:''};
const SETTINGS_KEY = 'agrumiyya-settings-v4';
const FAV_KEY = 'agrumiyya-favs-v4';
const DEFAULT_SETTINGS = {theme:'light', color:'brown', fontSize:17, fontFamily:'Amiri'};
let SETTINGS = {...DEFAULT_SETTINGS};
let FAVORITES = [];

/* ============================================================
   تحميل وحفظ
   ============================================================ */
function loadSettings(){
  try{const raw = localStorage.getItem(SETTINGS_KEY); if(raw) SETTINGS = {...DEFAULT_SETTINGS, ...JSON.parse(raw)};}catch(e){}
  applySettings();
}
function saveSettings(){ try{localStorage.setItem(SETTINGS_KEY, JSON.stringify(SETTINGS));}catch(e){} }
function applySettings(){
  document.documentElement.setAttribute('data-theme', SETTINGS.theme);
  document.documentElement.setAttribute('data-color', SETTINGS.color);
  document.documentElement.style.setProperty('--base-size', SETTINGS.fontSize+'px');
  const fontMap = {
    'Amiri':"'Amiri','Scheherazade New',serif", 'Scheherazade New':"'Scheherazade New','Amiri',serif",
    'Lateef':"'Lateef','Amiri',serif", 'Noto Naskh Arabic':"'Noto Naskh Arabic','Amiri',serif",
    'Cairo':"'Cairo','Amiri',sans-serif", 'Reem Kufi':"'Reem Kufi','Amiri',sans-serif"
  };
  document.documentElement.style.setProperty('--font-body', fontMap[SETTINGS.fontFamily] || fontMap['Amiri']);
}
function loadFavorites(){
  try{const raw = localStorage.getItem(FAV_KEY); if(raw) FAVORITES = JSON.parse(raw) || [];}catch(e){FAVORITES=[];}
  updateFavCount();
}
function saveFavorites(){ try{localStorage.setItem(FAV_KEY, JSON.stringify(FAVORITES));}catch(e){} updateFavCount(); }
function updateFavCount(){ const el = document.getElementById('fav-count'); if(el) el.textContent = FAVORITES.length ? `(${FAVORITES.length})` : ''; }

/* ============================================================
   أدوات
   ============================================================ */
function escapeHTML(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function stripHTML(html){const d=document.createElement('div');d.innerHTML=html||'';return d.textContent||'';}
function showToast(msg, ok=true){
  const t = document.getElementById('toast'); t.textContent = msg;
  t.style.background = ok ? 'var(--accent)' : '#c44';
  t.classList.add('show'); clearTimeout(t._timer);
  t._timer = setTimeout(()=>t.classList.remove('show'), 2200);
}
async function copyText(text){
  try{ await navigator.clipboard.writeText(text); showToast('✓ تم النسخ'); }
  catch(e){ const ta=document.createElement('textarea'); ta.value=text; document.body.appendChild(ta); ta.select();
    try{document.execCommand('copy'); showToast('✓ تم النسخ');}catch(e2){showToast('تعذّر النسخ',false);} document.body.removeChild(ta); }
}
async function shareContent(title, text){
  if(navigator.share){ try{ await navigator.share({title, text}); showToast('✓ تمت المشاركة'); return; }catch(e){ if(e.name==='AbortError') return; } }
  await copyText(text);
}
const ICONS = {
  copy:'<svg viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>',
  share:'<svg viewBox="0 0 24 24"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>',
  star:'<svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>'
};
function favKey(chId, type, idx){ return `${chId}:${type}:${idx}`; }
function isFav(key){ return FAVORITES.some(f=>f.key===key); }
function toggleFav(key, data){
  const idx = FAVORITES.findIndex(f=>f.key===key);
  if(idx>=0){ FAVORITES.splice(idx,1); showToast('أُزيل من المحفوظات', false); }
  else { FAVORITES.push({key, ...data, savedAt:Date.now()}); showToast('✓ حُفظ في المحفوظات'); }
  saveFavorites();
  document.querySelectorAll(`[data-favkey="${key}"]`).forEach(btn=>btn.classList.toggle('saved', isFav(key)));
}

/* ============================================================
   عرض الصفحة الرئيسية (القارئ)
   ============================================================ */
function renderReader(){
  const container = document.getElementById('view-reader');
  const ch = STATE.chapters[STATE.currentChapter];
  if(!ch) return;
  let html = `<div class="chapter-page">
    <div class="chapter-header">
      <span class="ch-num">${STATE.currentChapter+1}</span>
      <h2>${ch.title}</h2>
      <div class="ch-actions">
        <button class="icon-btn" onclick="copyChapter()" title="نسخ الباب">${ICONS.copy}</button>
        <button class="icon-btn" onclick="shareChapter()" title="مشاركة الباب">${ICONS.share}</button>
      </div>
    </div>`;

  // المتن
  if(ch.matn){
    html += `<div class="section-block">
      <div class="section-label">📖 المتن</div>
      <div class="matn-card"><div class="copy-share" style="float:left">
        <button class="icon-btn" onclick="copyMatn()" title="نسخ">${ICONS.copy}</button>
        <button class="icon-btn" onclick="shareMatn()" title="مشاركة">${ICONS.share}</button>
      </div>${ch.matn}</div>
    </div>`;
  }

  // النظم
  if(ch.nazm && ch.nazm.length){
    html += `<div class="section-block"><div class="section-label">✍️ النظم</div><div class="nazm-card">`;
    ch.nazm.forEach((v, i)=>{
      const key = favKey(ch.id, 'nazm', i);
      const favCls = isFav(key) ? 'saved' : '';
      html += `<div class="bayt">
        <div class="bayt-actions">
          <button class="icon-btn fav ${favCls}" data-favkey="${key}" onclick="toggleFav('${key}', {type:'nazm', sadr:'${escapeHTML(v[0]).replace(/'/g,"\\'")}', ajz:'${escapeHTML(v[1]||'').replace(/'/g,"\\'")}', chapter:'${escapeHTML(ch.title).replace(/'/g,"\\'")}', chapterId:'${ch.id}', idx:${i}})" title="حفظ">${ICONS.star}</button>
          <button class="icon-btn" onclick="copyVerse('nazm', ${i})" title="نسخ">${ICONS.copy}</button>
          <button class="icon-btn" onclick="shareVerse('nazm', ${i})" title="مشاركة">${ICONS.share}</button>
        </div>
        <span class="sadr">${v[0]}</span>
        ${v[1] ? `<span class="ajz">${v[1]}</span>` : ''}
      </div>`;
    });
    html += `</div></div>`;
  }

  // شواهد الألفية
  if(ch.alfia && ch.alfia.length){
    html += `<div class="section-block"><div class="section-label">📜 شاهد من ألفية ابن مالك</div><div class="alfia-card">`;
    ch.alfia.forEach((v, i)=>{
      const key = favKey(ch.id, 'alfia', i);
      const favCls = isFav(key) ? 'saved' : '';
      html += `<div class="bayt">
        <div class="bayt-actions">
          <button class="icon-btn fav ${favCls}" data-favkey="${key}" onclick="toggleFav('${key}', {type:'alfia', sadr:'${escapeHTML(v[0]).replace(/'/g,"\\'")}', ajz:'${escapeHTML(v[1]||'').replace(/'/g,"\\'")}', chapter:'${escapeHTML(ch.title).replace(/'/g,"\\'")}', chapterId:'${ch.id}', idx:${i}})" title="حفظ">${ICONS.star}</button>
          <button class="icon-btn" onclick="copyVerse('alfia', ${i})" title="نسخ">${ICONS.copy}</button>
          <button class="icon-btn" onclick="shareVerse('alfia', ${i})" title="مشاركة">${ICONS.share}</button>
        </div>
        <span class="sadr">${v[0]}</span>
        ${v[1] ? `<span class="ajz">${v[1]}</span>` : ''}
      </div>`;
    });
    html += `</div></div>`;
  }

  // الأسئلة
  if(ch.qas && ch.qas.length){
    html += `<div class="section-block"><div class="section-label">🔄 الأسئلة والأجوبة</div>`;
    ch.qas.forEach((qa, j)=>{
      html += `<div class="qa-card">
        <div class="q"><span class="lbl">س ${j+1}</span><p>${qa.q}</p>
          <div class="copy-share">
            <button class="icon-btn" onclick="copyQA(${j})" title="نسخ">${ICONS.copy}</button>
            <button class="icon-btn" onclick="shareQA(${j})" title="مشاركة">${ICONS.share}</button>
          </div>
        </div>
        <div class="a"><span class="lbl">ج</span><div class="a-body">${qa.a}</div></div>
      </div>`;
    });
    html += `</div>`;
  }

  html += `</div>`;
  container.innerHTML = html;

  // TOC
  const toc = document.getElementById('toc-list');
  toc.innerHTML = '';
  STATE.chapters.forEach((c, i)=>{
    const a = document.createElement('a');
    a.className = 'toc-item' + (i===STATE.currentChapter?' active':'');
    a.innerHTML = `<span class="num">${i+1}</span><span>${c.title}</span>`;
    a.addEventListener('click', ()=>{ STATE.currentChapter = i; renderReader(); window.scrollTo({top:0,behavior:'smooth'}); if(window.innerWidth<=768) closeMobileSidebar(); });
    toc.appendChild(a);
  });
  document.getElementById('toc-progress').textContent = `${STATE.currentChapter+1} / ${STATE.chapters.length}`;
  document.getElementById('brand-meta').textContent = `${STATE.chapters.length} بابًا · متن + نظم + شواهد + أسئلة`;
  document.getElementById('progress-bar').style.width = `${((STATE.currentChapter+1)/STATE.chapters.length)*100}%`;
  document.getElementById('to-top').classList.remove('show');
}

/* ============================================================
   Copy/Share للباب
   ============================================================ */
function getCurrentChapter(){ return STATE.chapters[STATE.currentChapter]; }
function copyChapter(){
  const ch = getCurrentChapter();
  let text = `📖 ${ch.title}\n\n`;
  if(ch.matn) text += `【المتن】\n${ch.matn}\n\n`;
  if(ch.nazm && ch.nazm.length) text += `【النظم】\n${ch.nazm.map(v=>v.join(' ❁ ')).join('\n')}\n\n`;
  if(ch.alfia && ch.alfia.length) text += `【شاهد الألفية】\n${ch.alfia.map(v=>v.join(' ❁ ')).join('\n')}\n\n`;
  if(ch.qas && ch.qas.length) text += `【الأسئلة】\n${ch.qas.map(qa=>`س: ${qa.q}\nج: ${qa.a}`).join('\n\n')}`;
  copyText(text);
}
function shareChapter(){ const ch = getCurrentChapter(); shareContent(ch.title, stripHTML(ch.matn||'') + '\n\n' + (ch.nazm||[]).map(v=>v.join(' ')).join('\n')); }
function copyMatn(){ const ch = getCurrentChapter(); if(ch.matn) copyText(`📖 ${ch.title}\n\n${ch.matn}`); }
function shareMatn(){ const ch = getCurrentChapter(); if(ch.matn) shareContent(ch.title, ch.matn); }
function copyVerse(type, idx){
  const ch = getCurrentChapter();
  const arr = type==='nazm' ? ch.nazm : ch.alfia;
  if(!arr || !arr[idx]) return;
  const v = arr[idx];
  copyText(`${type==='nazm'?'✍️ النظم':'📜 الألفية'}\n\n${v[0]}\n${v[1]||''}\n\n— ${ch.title}`);
}
function shareVerse(type, idx){
  const ch = getCurrentChapter();
  const arr = type==='nazm' ? ch.nazm : ch.alfia;
  if(!arr || !arr[idx]) return;
  const v = arr[idx];
  shareContent(ch.title, `${v[0]}\n${v[1]||''}\n\n— ${ch.title}`);
}
function copyQA(j){ const ch = getCurrentChapter(); const qa = ch.qas[j]; if(qa) copyText(`س: ${qa.q}\n\nج: ${qa.a}`); }
function shareQA(j){ const ch = getCurrentChapter(); const qa = ch.qas[j]; if(qa) shareContent(ch.title, `س: ${qa.q}\n\nج: ${qa.a}`); }

/* ============================================================
   المحفوظات
   ============================================================ */
function renderFavorites(){
  const container = document.getElementById('view-favorites');
  if(!FAVORITES.length){
    container.innerHTML = `<div class="empty-state"><span class="ico">⭐</span>لم تحفظ أي شيء بعد<br><small>اضغط على أيقونة النجمة بجانب أي متن أو بيت أو شاهد لحفظه هنا</small></div>`;
    return;
  }
  let html = `<div class="chapter-header"><h2>⭐ المحفوظات (${FAVORITES.length})</h2><button class="mini-btn" onclick="clearAllFavs()" style="background:#ffe4e8;color:#c44;border-color:#c44">🗑 حذف الكل</button></div>`;
  FAVORITES.slice().reverse().forEach((f, i)=>{
    const realIdx = FAVORITES.length-1-i;
    html += `<div class="fav-item">
      <div class="fav-actions">
        <button class="icon-btn" onclick="copyFav(${realIdx})" title="نسخ">${ICONS.copy}</button>
        <button class="icon-btn" onclick="shareFav(${realIdx})" title="مشاركة">${ICONS.share}</button>
        <button class="icon-btn" onclick="removeFav(${realIdx})" title="حذف" style="color:#c44">✕</button>
      </div>
      <div class="fav-chapter">📖 ${f.chapter || ''}</div>
      <div class="fav-verse"><span class="sadr">${f.sadr || ''}</span>${f.ajz ? `<span class="ajz">${f.ajz}</span>` : ''}</div>
    </div>`;
  });
  container.innerHTML = html;
}
function copyFav(i){ const f=FAVORITES[i]; if(f) copyText(`${f.chapter}\n\n${f.sadr}\n${f.ajz}`); }
function shareFav(i){ const f=FAVORITES[i]; if(f) shareContent(f.chapter, `${f.sadr}\n${f.ajz}\n\n— ${f.chapter}`); }
function removeFav(i){ FAVORITES.splice(i,1); saveFavorites(); renderFavorites(); document.querySelectorAll('[data-favkey]').forEach(b=>b.classList.toggle('saved', FAVORITES.some(f=>f.key===b.dataset.favkey))); }
function clearAllFavs(){ if(!confirm('حذف جميع المحفوظات؟')) return; FAVORITES=[]; saveFavorites(); renderFavorites(); document.querySelectorAll('[data-favkey]').forEach(b=>b.classList.remove('saved')); showToast('تم حذف الكل'); }

/* ============================================================
   الاختبار (سؤال يتبعه سؤال + توقيت اختياري + الانتقال للدرس)
   ============================================================ */
const QUIZ = {active:false, questions:[], currentIdx:0, answers:[], timed:false, timeLeft:0, timerId:null, chapterFilter:[]};

function renderQuiz(){
  const container = document.getElementById('view-quiz');
  if(QUIZ.active){ renderQuizQuestion(); return; }
  container.innerHTML = `<div class="quiz-setup">
    <h3>📝 إعداد الاختبار</h3>
    <div class="form-group">
      <label class="form-label">نوع الأسئلة</label>
      <select id="q-type" class="select-input" style="width:100%">
        <option value="mix">🔀 مختلط</option><option value="qa">🔄 أسئلة فقط</option><option value="nazm">✍️ أبيات النظم فقط</option><option value="alfia">📜 شواهد الألفية فقط</option>
      </select>
    </div>
    <div class="form-group">
      <label class="form-label">عدد الأسئلة</label>
      <div class="range-wrap"><input type="range" id="q-count" min="5" max="30" value="10"><span class="range-value" id="q-count-val">10</span></div>
    </div>
    <div class="form-group">
      <label class="form-label">⏱ التوقيت</label>
      <label style="display:flex;align-items:center;gap:8px;font-size:.85rem;color:var(--text-soft);cursor:pointer">
        <input type="checkbox" id="q-timed" style="accent-color:var(--accent)"> تفعيل التوقيت (دقيقة لكل سؤال)
      </label>
    </div>
    <div class="form-group">
      <label class="form-label">الأبواب <small>(اتركها فارغة = الكل)</small></label>
      <div class="chapter-controls"><button class="mini-btn" onclick="toggleAllCh(true)">تحديد الكل</button><button class="mini-btn" onclick="toggleAllCh(false)">إلغاء الكل</button></div>
      <div class="chapter-select" id="q-chapters">${STATE.chapters.map((c,i)=>`<label class="chapter-check"><input type="checkbox" value="${i}" class="q-ch"><span>${i+1}. ${c.title}</span></label>`).join('')}</div>
    </div>
    <div style="text-align:center;margin-top:16px"><button class="btn-primary" onclick="startQuiz()">🚀 ابدأ</button></div>
  </div>`;
  document.getElementById('q-count').addEventListener('input', e=>document.getElementById('q-count-val').textContent = e.target.value);
  container.querySelectorAll('.q-ch').forEach(cb=>cb.addEventListener('change', ()=>cb.closest('.chapter-check').classList.toggle('checked', cb.checked)));
}
function toggleAllCh(v){ document.querySelectorAll('.q-ch').forEach(cb=>{cb.checked=v; cb.closest('.chapter-check').classList.toggle('checked', v);}); }

function startQuiz(){
  const type = document.getElementById('q-type').value;
  const count = parseInt(document.getElementById('q-count').value, 10);
  const timed = document.getElementById('q-timed').checked;
  const selected = Array.from(document.querySelectorAll('.q-ch:checked')).map(cb=>parseInt(cb.value,10));
  const chapters = selected.length ? selected.map(i=>STATE.chapters[i]) : STATE.chapters;

  let pool = [];
  chapters.forEach((ch, ci)=>{
    if((type==='mix'||type==='qa') && ch.qas) ch.qas.forEach((qa,i)=>{ pool.push({type:'qa', question:qa.q, correct:stripHTML(qa.a).substring(0,80), chapter:ch.title, chapterId:ch.id, options:null}); });
    if((type==='mix'||type==='nazm') && ch.nazm) ch.nazm.forEach((v,i)=>{ pool.push({type:'nazm', question:`من أي باب هذا البيت؟\n«${v[0]} ❁ ${v[1]||''}»`, correct:ch.title, chapter:ch.title, chapterId:ch.id, options:null}); });
    if((type==='mix'||type==='alfia') && ch.alfia) ch.alfia.forEach((v,i)=>{ pool.push({type:'alfia', question:`من أي باب هذا الشاهد من الألفية؟\n«${v[0]} ❁ ${v[1]||''}»`, correct:ch.title, chapter:ch.title, chapterId:ch.id, options:null}); });
  });
  if(!pool.length){ showToast('لا توجد أسئلة كافية', false); return; }
  pool = shuffle(pool).slice(0, count);
  // Build options
  const allTitles = STATE.chapters.map(c=>c.title);
  pool.forEach(q=>{
    if(q.type==='qa'){
      const wrongPool = STATE.chapters.flatMap(c=>(c.qas||[]).map(x=>stripHTML(x.a).substring(0,80))).filter(x=>x!==q.correct);
      q.options = shuffle([q.correct, ...shuffle(wrongPool).slice(0,3)]);
    } else {
      const wrongs = shuffle(allTitles.filter(t=>t!==q.correct)).slice(0,3);
      q.options = shuffle([q.correct, ...wrongs]);
    }
  });
  QUIZ.active = true; QUIZ.questions = pool; QUIZ.currentIdx = 0; QUIZ.answers = new Array(pool.length).fill(null);
  QUIZ.timed = timed; QUIZ.timeLeft = timed ? 60 : 0;
  renderQuizQuestion();
}
function shuffle(a){const arr=[...a];for(let i=arr.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[arr[i],arr[j]]=[arr[j],arr[i]];}return arr;}

function renderQuizQuestion(){
  if(QUIZ.timerId){ clearInterval(QUIZ.timerId); QUIZ.timerId=null; }
  const container = document.getElementById('view-quiz');
  if(QUIZ.currentIdx >= QUIZ.questions.length){ showQuizResult(); return; }
  const q = QUIZ.questions[QUIZ.currentIdx];
  const answered = QUIZ.answers[QUIZ.currentIdx];
  let html = `<div class="chapter-header"><span class="ch-num">${QUIZ.currentIdx+1}/${QUIZ.questions.length}</span><h2>${q.type==='qa'?'🔄 سؤال':q.type==='nazm'?'✍️ بيت':'📜 شاهد'}</h2>
    ${QUIZ.timed?`<div class="timer-box" id="timer">⏱ ${formatTime(QUIZ.timeLeft)}</div>`:''}
  </div>
  <div class="qz-card">
    <div class="qz-text" style="white-space:pre-line">${escapeHTML(q.question)}</div>
    <div class="qz-options">`;
  q.options.forEach(opt=>{
    let cls = '';
    if(answered !== null){
      if(opt === q.correct) cls = 'correct';
      else if(opt === answered) cls = 'wrong';
    }
    html += `<div class="qz-option ${cls}" ${answered===null?`onclick="answerQuiz('${escapeHTML(opt).replace(/'/g,"\\'")}')"`:''}>${escapeHTML(opt)}</div>`;
  });
  html += `</div>`;
  if(answered !== null){
    const ok = answered === q.correct;
    html += `<div class="qz-feedback show ${ok?'ok':'no'}">${ok?'✓ إجابة صحيحة':'✗ الإجابة الصحيحة: '+escapeHTML(q.correct)}</div>`;
  }
  html += `</div>
  <div class="qz-nav">
    ${QUIZ.currentIdx>0?`<button class="prev" onclick="prevQuiz()">← السابق</button>`:''}
    ${answered!==null?`<button class="goto" onclick="gotoChapter('${q.chapterId}')">📖 اذهب إلى الدرس</button>`:''}
    ${QUIZ.currentIdx<QUIZ.questions.length-1?`<button class="next" onclick="nextQuiz()">التالي →</button>`:`<button class="next" onclick="showQuizResult()">عرض النتيجة</button>`}
  </div>`;
  container.innerHTML = html;
  if(QUIZ.timed && answered===null) startTimer();
}
function formatTime(s){ return `${Math.floor(s/60)}:${String(s%60).padStart(2,'0')}`; }
function startTimer(){
  QUIZ.timerId = setInterval(()=>{
    QUIZ.timeLeft--; const el = document.getElementById('timer');
    if(el){ el.textContent = `⏱ ${formatTime(QUIZ.timeLeft)}`; if(QUIZ.timeLeft<=10) el.classList.add('warning'); }
    if(QUIZ.timeLeft<=0){ clearInterval(QUIZ.timerId); QUIZ.timerId=null; nextQuiz(); }
  }, 1000);
}
function answerQuiz(opt){
  QUIZ.answers[QUIZ.currentIdx] = opt;
  if(QUIZ.timerId){ clearInterval(QUIZ.timerId); QUIZ.timerId=null; }
  renderQuizQuestion();
}
function nextQuiz(){ if(QUIZ.currentIdx<QUIZ.questions.length-1){ QUIZ.currentIdx++; QUIZ.timeLeft=QUIZ.timed?60:0; renderQuizQuestion(); } else showQuizResult(); }
function prevQuiz(){ if(QUIZ.currentIdx>0){ QUIZ.currentIdx--; QUIZ.timeLeft=QUIZ.timed?60:0; renderQuizQuestion(); } }
function gotoChapter(chId){
  const idx = STATE.chapters.findIndex(c=>c.id===chId);
  if(idx>=0){ STATE.currentChapter=idx; switchView('reader'); showToast('📖 انتقلت إلى الدرس'); }
}
function showQuizResult(){
  if(QUIZ.timerId){ clearInterval(QUIZ.timerId); QUIZ.timerId=null; }
  const correct = QUIZ.questions.filter((q,i)=>QUIZ.answers[i]===q.correct).length;
  const pct = Math.round((correct/QUIZ.questions.length)*100);
  let emoji='📚', grade='يحتاج مراجعة';
  if(pct>=90){emoji='🏆';grade='ممتاز';}else if(pct>=80){emoji='⭐';grade='جيد جدًا';}else if(pct>=70){emoji='👍';grade='جيد';}else if(pct>=60){emoji='✅';grade='مقبول';}
  document.getElementById('view-quiz').innerHTML = `<div class="quiz-result">
    <div style="font-size:4rem;margin-bottom:10px">${emoji}</div>
    <div class="score-num">${correct} / ${QUIZ.questions.length}</div>
    <div class="score-pct">${pct}% — ${grade}</div>
    <div class="score-text">أجبت على ${correct} من ${QUIZ.questions.length} سؤالًا بشكل صحيح</div>
    <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:20px">
      <button class="btn-primary" onclick="resetQuiz()">🔄 اختبار جديد</button>
      <button class="btn-secondary" onclick="showQuizReview()">📝 مراجعة الإجابات</button>
    </div>
  </div>`;
}
function showQuizReview(){
  let html = `<div class="chapter-header"><h2>📝 مراجعة الإجابات</h2><button class="mini-btn" onclick="showQuizResult()">← النتيجة</button></div>`;
  QUIZ.questions.forEach((q,i)=>{
    const ans = QUIZ.answers[i]; const ok = ans===q.correct;
    html += `<div class="qz-card"><div class="qz-header"><span class="qz-num">${i+1}</span><span class="qz-type">${ok?'✓':'✗'}</span></div>
      <div class="qz-text" style="white-space:pre-line">${escapeHTML(q.question)}</div><div class="qz-options">`;
    q.options.forEach(o=>{ let cls=''; if(o===q.correct)cls='correct'; else if(o===ans&&!ok)cls='wrong'; html+=`<div class="qz-option ${cls}">${escapeHTML(o)}</div>`; });
    html += `</div></div>`;
  });
  document.getElementById('view-quiz').innerHTML = html;
}
function resetQuiz(){ QUIZ.active=false; renderQuiz(); }

/* ============================================================
   الألعاب
   ============================================================ */
function renderGames(){
  document.getElementById('view-games').innerHTML = `
    <div class="chapter-header"><h2>🎮 ألعاب تعليمية</h2></div>
    <div class="game-card"><h3>🔗 طابق المصطلح بتعريفه</h3><p style="font-size:.82rem;color:var(--muted);margin-bottom:10px">اختر مصطلحًا من العمود الأيمن ثم تعريفه من الأيسر</p><div class="match-grid" id="match-grid"></div><div id="match-msg" style="text-align:center;margin-top:10px;font-weight:700;color:var(--accent)"></div></div>
    <div class="game-card"><h3>🧩 رتب الكلمات</h3><p style="font-size:.82rem;color:var(--muted);margin-bottom:10px">اضغط على الكلمات بالترتيب لتكوين جملة صحيحة</p><div class="arrange-container"><div class="arrange-target" id="arrange-target"></div><div class="arrange-source" id="arrange-source"></div></div><div style="margin-top:12px;text-align:center"><button class="btn-secondary" onclick="checkArrange()">تحقق</button><button class="btn-secondary" onclick="resetArrange()" style="margin-right:6px">إعادة</button></div><div id="arrange-msg" style="text-align:center;margin-top:10px;font-weight:700;color:var(--accent)"></div></div>
    <div class="game-card"><h3>❓ خمن الباب</h3><p style="font-size:.82rem;color:var(--muted);margin-bottom:10px">اقرأ البيت واختر الباب الصحيح</p><div id="guess-game"></div></div>`;
  initMatchGame(); initArrangeGame(); initGuessGame();
}

/* لعبة المطابقة */
function initMatchGame(){
  const pairs = [
    {term:'الفاعل', def:'الاسم المرفوع المذكور قبله فعله'},
    {term:'المفعول به', def:'الاسم المنصوب الذي يقع عليه فعل الفاعل'},
    {term:'المبتدأ', def:'الاسم المرفوع العاري عن العوامل اللفظية'},
    {term:'الحال', def:'الاسم المنصوب المفسر لما استبهم من الهيئات'},
    {term:'التمييز', def:'الاسم المنصوب المفسر لما استبهم من الذوات'}
  ];
  const shuffledDefs = shuffle(pairs.map(p=>p.def));
  const grid = document.getElementById('match-grid');
  let selectedTerm = null;
  grid.innerHTML = '';
  const termCol = document.createElement('div');
  const defCol = document.createElement('div');
  pairs.forEach(p=>{ const d=document.createElement('div'); d.className='match-item'; d.textContent=p.term; d.dataset.term=p.term; termCol.appendChild(d); });
  shuffledDefs.forEach(d=>{ const el=document.createElement('div'); el.className='match-item'; el.textContent=d; el.dataset.def=d; defCol.appendChild(el); });
  grid.appendChild(termCol); grid.appendChild(defCol);
  grid.querySelectorAll('[data-term]').forEach(el=>el.addEventListener('click', ()=>{
    if(el.classList.contains('matched')) return;
    grid.querySelectorAll('[data-term]').forEach(x=>x.classList.remove('selected'));
    el.classList.add('selected'); selectedTerm = el.dataset.term;
  }));
  grid.querySelectorAll('[data-def]').forEach(el=>el.addEventListener('click', ()=>{
    if(!selectedTerm || el.classList.contains('matched')) return;
    const correctDef = pairs.find(p=>p.term===selectedTerm)?.def;
    if(el.dataset.def === correctDef){
      el.classList.add('matched');
      grid.querySelector(`[data-term="${selectedTerm}"]`).classList.add('matched');
      document.getElementById('match-msg').textContent = '✓ إجابة صحيحة!';
      setTimeout(()=>document.getElementById('match-msg').textContent='', 1200);
    } else { document.getElementById('match-msg').textContent = '✗ حاول مرة أخرى'; setTimeout(()=>document.getElementById('match-msg').textContent='', 1200); }
    selectedTerm = null; grid.querySelectorAll('[data-term]').forEach(x=>x.classList.remove('selected'));
  }));
}

/* لعبة الترتيب */
let arrangeWords = [], arrangeTarget = [];
function initArrangeGame(){
  const sentences = [
    ['الكلامُ','هو','اللفظُ','المركبُ','المفيدُ','بالوضعِ'],
    ['الفاعلُ','هو','الاسمُ','المرفوعُ','المذكورُ','قبله','فعلُه'],
    ['المبتدأُ','هو','الاسمُ','المرفوعُ','العارِي','عن','العواملِ','اللفظيةِ'],
    ['الحالُ','هو','الاسمُ','المنصوبُ','المفسرُ','لما','استبهم','من','الهيئاتِ']
  ];
  const sent = sentences[Math.floor(Math.random()*sentences.length)];
  arrangeWords = shuffle([...sent]);
  arrangeTarget = [];
  renderArrange();
}
function renderArrange(){
  const target = document.getElementById('arrange-target');
  const source = document.getElementById('arrange-source');
  target.innerHTML = arrangeTarget.map((w,i)=>`<span class="arrange-word" onclick="removeArrange(${i})">${w}</span>`).join('');
  source.innerHTML = arrangeWords.map((w,i)=>`<span class="arrange-word ${arrangeTarget.includes(w)?'used':''}" onclick="addArrange('${w}')">${w}</span>`).join('');
}
function addArrange(w){ if(!arrangeTarget.includes(w)){ arrangeTarget.push(w); renderArrange(); } }
function removeArrange(i){ arrangeTarget.splice(i,1); renderArrange(); }
function checkArrange(){
  const msg = document.getElementById('arrange-msg');
  const target = arrangeTarget.join(' ');
  const candidates = [
    'الكلام هو اللفظ المركب المفيد بالوضع',
    'الفاعل هو الاسم المرفوع المذكور قبله فعله',
    'المبتدأ هو الاسم المرفوع العاري عن العوامل اللفظية',
    'الحال هو الاسم المنصوب المفسر لما استبهم من الهيئات'
  ];
  if(candidates.some(c=>c.replace(/\s+/g,' ').trim() === target.replace(/\s+/g,' ').trim())){
    msg.textContent = '✓ أحسنت! ترتيب صحيح'; msg.style.color = '#28a745';
  } else { msg.textContent = '✗ الترتيب غير صحيح، حاول مرة أخرى'; msg.style.color = '#dc3545'; }
  setTimeout(()=>msg.textContent='', 2500);
}
function resetArrange(){ arrangeTarget=[]; initArrangeGame(); }

/* لعبة تخمين الباب */
function initGuessGame(){
  const pool = [];
  STATE.chapters.forEach(ch=>{
    if(ch.nazm) ch.nazm.forEach(v=>pool.push({verse:v, chapter:ch.title}));
    if(ch.alfia) ch.alfia.forEach(v=>pool.push({verse:v, chapter:ch.title}));
  });
  if(!pool.length){ document.getElementById('guess-game').innerHTML='<p>لا توجد أبيات</p>'; return; }
  const item = pool[Math.floor(Math.random()*pool.length)];
  const options = shuffle([item.chapter, ...STATE.chapters.map(c=>c.title).filter(t=>t!==item.chapter).slice(0,3)]);
  let html = `<div class="qz-text" style="white-space:pre-line">«${item.verse[0]} ❁ ${item.verse[1]||''}»</div><div class="qz-options">`;
  options.forEach(o=>html += `<div class="qz-option" onclick="checkGuess(this,'${escapeHTML(o).replace(/'/g,"\\'")}','${escapeHTML(item.chapter).replace(/'/g,"\\'")}')">${escapeHTML(o)}</div>`);
  html += `</div><div id="guess-msg" style="text-align:center;margin-top:10px;font-weight:700"></div>`;
  document.getElementById('guess-game').innerHTML = html;
}
function checkGuess(el, chosen, correct){
  document.querySelectorAll('#guess-game .qz-option').forEach(o=>{ o.style.pointerEvents='none'; if(o.textContent.trim()===correct) o.classList.add('correct'); });
  const msg = document.getElementById('guess-msg');
  if(chosen===correct){ el.classList.add('correct'); msg.textContent='✓ إجابة صحيحة'; msg.style.color='#28a745'; }
  else { el.classList.add('wrong'); msg.textContent='✗ الإجابة الصحيحة: '+correct; msg.style.color='#dc3545'; }
  setTimeout(()=>initGuessGame(), 2500);
}

