    <div class="settings-card"><h3>⚙️ إجراءات</h3><button class="btn-secondary" onclick="resetSettings()">🔄 إعادة الافتراضي</button></div>`;
  document.getElementById('fs-slider').addEventListener('input', e=>{ SETTINGS.fontSize=parseInt(e.target.value,10); applySettings(); saveSettings(); document.getElementById('fs-val').textContent=SETTINGS.fontSize+'px'; });
  document.getElementById('font-sel').addEventListener('change', e=>{ SETTINGS.fontFamily=e.target.value; applySettings(); saveSettings(); renderSettings(); });
