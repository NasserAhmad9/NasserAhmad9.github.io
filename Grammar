    {id:'blue',name:'أزرق',c1:'#1d4e89',c2:'#4895ef'},{id:'purple',name:'بنفسجي',c1:'#5a189a',c2:'#9d4edd'},
    {id:'teal',name:'تركوازي',c1:'#006d77',c2:'#2a9d8f'},{id:'rose',name:'وردي',c1:'#a4133c',c2:'#ff4d6d'}
  ];
  const fonts = ['Amiri','Scheherazade New','Lateef','Noto Naskh Arabic','Cairo','Reem Kufi'];
